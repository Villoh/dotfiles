theme
{
	name = "modern"

	view = view.small

	background
	{
		color = #0d0c0c
		opacity = 100
		// effect = 2
	}

	item
	{
		opacity = 100

		prefix = 1

		text
		{
			normal = #c5c9c5
			select = #c5c9c5
			normal-disabled = #8a9a7b
			select-disabled = #8a9a7b
		}

		back
		{
			select = #1d1c19
			select-disabled = #0d0c0c
		}
	}

	// font
	// {
	// 	size = 14
	// 	name = "Segoe UI Variable Text"
	// 	weight = 2
	// 	italic = 0
	// }

	border
	{
		enabled = true
		size = 1
		color = #8992a7
		opacity = 100
		radius = 2
	}

	shadow
	{
		enabled = true
		size = 5
		opacity = 5
		color = #0d0c0c
	}

	separator
	{
		size = 1
		color = #1d1c19
	}

	symbol
	{
		normal = #8992a7
		select = #8ba4b0
		normal-disabled = #8a9a7b
		select-disabled = #8a9a7b
	}

	image
	{
		enabled = true
		color = [#c5c9c5, #8992a7, #0d0c0c]
	}
}