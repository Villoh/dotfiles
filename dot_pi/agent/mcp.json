{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "inheritEnv": false
    },
    "wealthfolio": {
      "type": "http",
      "url": "http://127.0.0.1:8639/mcp",
      "headers": {
        "Authorization": "Bearer ${WEALTHFOLIO_TOKEN}"
      },
      "enabled": false
    }
  }
}
