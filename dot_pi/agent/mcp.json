{
  "mcpServers": {
    "atlassian": {
      "url": "https://mcp.atlassian.com/v2/mcp?tools=all",
      "description": "Wannme Jira and Confluence (wannme.atlassian.net): attach files to issues, read and search",
      "toolExposure": {
        "delete*": "hidden"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "inheritEnv": false
    },
    "wealthfolio": {
      "type": "http",
      "url": "http://127.0.0.1:8639/mcp",
      "headers": {
        "Authorization": "Bearer ${WEALTHFOLIO_TOKEN}"
      },
      "enabled": false
    }
  }
}
