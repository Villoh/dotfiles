{{- $piHome := .chezmoi.homeDir | replace "\\" "/" -}}
{
  "lastChangelogVersion": "0.84.2",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-rtk-optimizer",
    "npm:pi-caveman",
    "npm:@upstash/context7-pi",
    "git:github.com/DietrichGebert/ponytail",
    "npm:@ff-labs/pi-fff",
    "npm:pi-lens",
    "npm:@router-for-me/pi-cliproxyapi-provider",
    {{/* git:github.com/obra/superpowers - Commented out: enable only when needed. */}}
    "npm:pi-smart-fetch",
    "npm:@injaneity/pi-computer-use",
    "npm:pi-taskflow",
    "npm:pi-mermaid",
    "npm:@juicesharp/rpiv-todo",
    {{/* npm:@tintinweb/pi-tasks - Claude Code-style task tracking (TaskCreate/List/Get/Update/Execute + widget + deps).
      Commented out: not installed/tested yet, richer than needed for a simple todo list.
      Uncomment to enable once tried. See https://github.com/tintinweb/pi-tasks */}}
    "npm:pi-rewind-hook",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@diegopetrucci/pi-dirty-repo-guard",
    "npm:@diegopetrucci/pi-notify",
    "npm:@99percentpeople/pi-background-tasks",
    {{/* npm:pi-interactive-shell - Commented out: its interactive overlay interferes with terminal UX. Re-enable when needed. */}}
    "npm:pi-messenger",
    "npm:pi-intercom",
    "npm:@99percentpeople/pi-pwsh-adapter",
    {{ if eq .chezmoi.os "windows" }}"../../development/personal/projects/pi/pi-extensions/packages/pi-auto-name-session"{{ else }}"npm:pi-auto-name-session"{{ end }},
    {{ if eq .chezmoi.os "windows" }}"../../development/personal/projects/pi/pi-extensions/packages/pi-btw"{{ else }}"npm:pi-btw"{{ end }},
    {{ if eq .chezmoi.os "windows" }}"../../development/personal/projects/pi/pi-extensions/packages/pi-cliproxy-usage"{{ else }}"npm:pi-cliproxy-usage"{{ end }},
    {{ if eq .chezmoi.os "windows" }}"../../development/personal/projects/pi/pi-extensions/packages/pi-permission-system"{{ else }}"npm:@gotgenes/pi-permission-system"{{ end }}
    {{/* npm:pi-sandbox - OS-level bash sandboxing (network + filesystem) via sandbox-exec (macOS) or bubblewrap (Linux),
      with interactive allow/deny prompts. Commented out: macOS/Linux only, no Windows support (this host), also
      requires ripgrep on PATH. Revisit if working from WSL/Linux/macOS. See https://github.com/carderne/pi-sandbox */}}
  ],
  "powerline": {
    "preset": "default",
    "fixedEditor": true
  },
  "npmCommand": [
    "npm"
  ],
  "hideThinkingBlock": false,
  "theme": "dark",
  "modelRoles": {
    "steward": "cliproxyapi/gpt-5.6-luna",
    "expert": "cliproxyapi/claude-opus-5",
    "builder": "cliproxyapi/gpt-5.6-terra",
    "scout": "cliproxyapi/gpt-5.6-luna",
    "frontend_designer": "cliproxyapi/claude-opus-5"
  },
  "taskflow": {
    "builtInAgents": true,
    "syncBuiltinAgentsToProject": false,
    "piChild": {
      "resourceProfile": "allowlist",
      "extensions": [
        "{{ $piHome }}/.pi/agent/npm/node_modules/@router-for-me/pi-cliproxyapi-provider/extensions/index.ts",
        "{{ $piHome }}/.pi/agent/npm/node_modules/pi-rtk-optimizer/index.ts"
      ],
      "terminalGraceMs": 1500
    }
  },
  "defaultProvider": "cliproxyapi",
  "defaultModel": "gpt-5.6-luna"
}
