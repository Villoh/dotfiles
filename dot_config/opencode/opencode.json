{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "plugin": [
    [
      "superpowers@git\u002Bhttps://github.com/obra/superpowers.git",
      {
        "enabled": true
      }
    ],
    [
      "@dietrichgebert/ponytail",
      {
        "enabled": true
      }
    ],
    [
      "oc-plugin-vault-tec",
      {
        "enabled": false,
        "mode": "append"
      }
    ],
    [
      "@plannotator/opencode@latest",
      {
        "enabled": true,
        "mode": "append"
      }
    ],
    "./plugins/caveman/plugin.js"
  ],
  "mcp": {
    "caveman-shrink": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "caveman-shrink"
      ],
      "enabled": false
    }
  },
  "provider": {
    "tunnel-agent-cliproxy": {
      "name": "Tunnel Agent",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "litellmProxy": true,
        "apiKey": "no-key"
      },
      "models": {
        "claude-fable-5": {
          "name": "Claude Fable 5 (Tunnel Agent)"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5 (Tunnel Agent)"
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5 (Tunnel Agent)"
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (2x usage) (Tunnel Agent)"
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol (Tunnel Agent)"
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra (Tunnel Agent)"
        },
        "gpt-image-2": {
          "name": "GPT-Image-2 (Tunnel Agent)"
        }
      }
    }
  }
}