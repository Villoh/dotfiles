[include]
    path = ~/.config/git/local
    path = ~/.config/git/platform
[includeIf "gitdir:~/development/work/wannme/"]
    path = ~/.config/git/work
[init]
	defaultBranch = main
[core]
	editor = zed
	autocrlf = true
[pull]
	rebase = false
[alias]
  # ============================================================================
  # SPEED - Most used commands should be short
  # ============================================================================
  s = status -sb
  st = status -sb
  a = add
  aa = add -A
  ap = add -p
  gap = add -A -p

  c = commit --verbose
  ca = commit -a --verbose
  cm = commit -m
  cam = commit -a -m
  m = commit --amend --verbose
  amend = commit --amend --no-edit
  can = commit --amend --no-edit
  quick-amend = commit --amend -C HEAD

  co = checkout
  cob = checkout -b
  new = checkout -b

  br = branch -v
  gbr = branch -v
  bra = branch -a
  brd = branch -d
  brD = branch -D

  d = diff -M
  df = diff -M
  dw = diff --color-words
  dd = diff -M --color-words="."
  dt = diff --word-diff-regex=.
  ds = diff --stat
  dc = diff --cached -M
  dcs = diff --cached --stat
  dws = diff --color-words --staged
  dts = diff --word-diff-regex=. --staged
  dcd = diff --cached -M --color-words="."
  dft = difftool
  diffst = diff --name-only

  f = fetch
  gf = fetch

  p = push
  gp = push
  pu = push -u origin HEAD
  pushu = push -u origin HEAD
  pushf = push --force-with-lease

  up = pull
  gup = pull

  gm = merge --no-ff
  gmf = merge --ff-only

  rb = rebase
  grb = rebase -p
  rba = rebase --abort
  grba = rebase --abort
  rbc = rebase --continue
  grbc = rebase --continue
  rbi = rebase -i
  grbi = rebase -i

  r = reset
  gr = reset
  rh = reset --hard
  grh = reset --hard
  rsh = reset --soft HEAD~
  grsh = reset --soft HEAD~
  unc = reset --mixed HEAD~1

  rv = remote -v
  grv = remote -v

  sh = show
  gs = show
  shd = show --color-words="."
  gsd = show --color-words="."

  sl = stash list
  gst = stash
  sp = stash pop
  gstp = stash pop
  ss = stash save -u

  ch = cherry-pick
  gch = cherry-pick

  # ============================================================================
  # LOGS - Beautiful and useful log formats
  # ============================================================================
  l = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  ll = log --oneline --decorate --graph --all
  glog = log --date-order --pretty="format:%C(yellow)%h%Cblue%d%Creset %s %C(white) %an, %ar%Creset"
  gl = log --graph --date-order --pretty="format:%C(yellow)%h%Cblue%d%Creset %s %C(white) %an, %ar%Creset"
  gla = log --graph --all --date-order --pretty="format:%C(yellow)%h%Cblue%d%Creset %s %C(white) %an, %ar%Creset"
  hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
  last = log -1 HEAD --stat
  today = log --since='midnight' --author='$(git config user.name)' --oneline
  log-me = "!sh -c 'git log --author=\"$(git config user.name)\" $@' -"
  log-b = "!sh -c 'git log $(git remote-default)..HEAD $@' -"
  log-n = "!sh -c 'git log origin/$(git remote-default)..HEAD $@' -"
  log-t = "!sh -c 'git log --tags --simplify-by-decoration $@' -"

  # ============================================================================
  # BRANCH MANAGEMENT - List, sort, clean
  # ============================================================================
  b = "!git for-each-ref --sort='-authordate' --format='%(authordate)%09%(objectname:short)%09%(refname)' refs/heads | sed -e 's-refs/heads/--'"
  merged = branch --merged
  unmerged = branch --no-merged
  dates = "!git for-each-ref --sort=-committerdate --format='%(committerdate:short) %(refname:short)' refs/heads/"
  track = "!sh -c 'git fetch origin && git checkout --track origin/$1' -"

  # Branch delete: checkout master and delete all merged branches
  brd-merged = "!sh -c \"git checkout master && git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d\""

  # Branch delete here: delete all branches merged to current branch
  brd-here = "!sh -c \"git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d\""

  # NOTE: `old` (branch overview w/ ahead/behind/merged) moved to a real
  # command: dot_local/bin/git-old (Linux) / Documents/PowerShell/Functions/git-workflow.ps1 (Windows).

  # ============================================================================
  # UNDO & RESET - Various ways to undo changes
  # ============================================================================
  undo = reset --soft HEAD~1
  unstage = reset HEAD --
  nuke = reset --hard HEAD
  wipe = "!git reset --hard && git clean -fd"
  wip = "!git add -A && git commit -m 'WIP'"
  oops = "!git add -A && git commit --amend --no-edit"

  # Forced pull: reset local branch to match remote (DESTRUCTIVE!)
  pullf = "!sh -c \"git reset --hard origin/$(git rev-parse --abbrev-ref HEAD)\""

  # ============================================================================
  # SYNC - Fetch, pull helpers
  # ============================================================================
  sync = "!git fetch --all --prune && git pull"

  # NOTE: `remote-default` and `remote-set` moved to real commands:
  # dot_local/bin/git-remote-default / git-remote-set (Linux),
  # Get-GitRemoteDefault / Set-GitRemote in git-workflow.ps1 (Windows).

  # ============================================================================
  # WORKTREES - Multiple working directories
  # ============================================================================
  wt = worktree
  wtl = worktree list
  wta = worktree add
  wtr = worktree remove

  # ============================================================================
  # CONFLICTS - short aliases for the git-conflict / git-can-merge commands
  # (dot_local/bin/git-conflict, git-can-merge on Linux;
  #  Test-GitConflict / Test-GitCanMerge in git-workflow.ps1 on Windows)
  # ============================================================================
  cf = conflict
  cfm = can-merge

  # NOTE: `continue`, `abort`, `prune-local`, `clean-merged`, `auto-prune`,
  # `fixup`, `rebranch`, `yank`, `backmerge`, `churn`, `lines`, `sha`, `zip`,
  # `diff-file-last-commit`, `exclude`, `include`, `tree` all moved to real
  # commands in dot_local/bin/git-* (Linux) and git-workflow.ps1 (Windows) —
  # see docs/omarchy-migration.md for the full mapping. Prefer `git absorb
  # --and-rebase` (git-absorb, pacman -S git-absorb) over `git fixup` when available.

  # ============================================================================
  # ADVANCED WORKFLOWS
  # ============================================================================
  savepoint = "!bash -c 'git add -A && git commit -m \"WIP $(date \"+%Y-%m-%d %I:%M %p\")\"'"

  # ============================================================================
  # UTILITIES - Helpful commands
  # ============================================================================
  pwd = "!git rev-parse --show-toplevel"
  contributors = shortlog -sn --no-merges
  aliases = "!git config --get-regexp '^alias\\.' | cut -d' ' -f1 | sed 's/^alias\\.//' | sort | column -c $(tput cols)"
  la = "!git config -l | grep alias | cut -c 7-"
  find = "!git ls-files | grep -i"
  grep = grep -Ii
  files = "!sh -c 'git show --name-only --pretty=\"\" $@' -"

  # Get current tag
  current-tag = tag --points-at HEAD

  # ============================================================================
  # REVERT SHORTCUTS
  # ============================================================================
  rollback = revert
  rc = revert
  rcn = revert --no-commit
  rce = revert --edit
  rcq = revert --no-edit
  rcm = revert -m 1
  rclast = revert HEAD

  # NOTE: GitHub CLI passthroughs (whoami, pr, issue, gist, browse, auth, org,
  # project, release, repo, codespace, pr-info, pr-view, co-commit,
  # init-github, code-review, publish, languages) were dropped — just use
  # `gh` directly, these added no value over it.
  #
  # NOTE: the gist-based alias backup (aliases-gist/export/import/docs/alist)
  # was dropped — it had a literal unfilled `YOUR_GIST_ID_HERE` placeholder
  # and had never actually worked.
  #
  # NOTE: the LAN git server (server-addr/start/kill/test/clone/join/logs)
  # was consolidated into one command: dot_local/bin/git-lan-serve (Linux,
  # `git lan-serve <verb>`), git-lan-serve.ps1 functions (Windows).
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
