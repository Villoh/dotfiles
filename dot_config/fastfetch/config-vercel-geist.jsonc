{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "C:/Users/Mikel/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#0072F5",
      "2": "#52A8FF",
      "3": "#12A594",
      "4": "#45A557",
      "5": "#FF990A",
      "6": "#FFB224",
      "7": "#E5484D",
      "8": "#A1A1A1",
      "9": "#EDEDED"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
    "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#0072F5",
        "at": "#A1A1A1",
        "host": "#52A8FF"
      }
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "#12A594"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "#45A557"
    },
    {
      "type": "board",
      "key": "󰚗",
      "keyColor": "#FF990A"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#FFB224",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#0072F5"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
