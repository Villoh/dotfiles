#:schema https://yazi-rs.github.io/schemas/yazi.json

[mgr]
# Parent | current | preview: a wide preview pane, like Strata's Columns view.
ratio          = [ 1, 3, 4 ]
sort_by        = "natural"
sort_dir_first = true
sort_translit  = true
show_hidden    = true
# Custom linemode defined in init.lua: size and modification time.
linemode       = "size_and_mtime"

[preview]
image_delay   = 20
image_filter  = "lanczos3"
image_quality = 90
max_width     = 1600
max_height    = 1600

{{ if ne .chezmoi.os "windows" }}
# Presets (edit, open, play, reveal, extract, trash...) stay; these add
# the apps installed on this machine, reachable with `O` (open interactively).
[opener]
strata = [
  { run = 'strata %s1', orphan = true, desc = "Strata", for = "linux" },
]
nvim = [
  { run = 'nvim %s', block = true, desc = "Neovim", for = "unix" },
]
imv = [
  { run = 'imv %s', orphan = true, desc = "imv", for = "linux" },
]
mpv = [
  { run = 'mpv %s', orphan = true, desc = "mpv", for = "unix" },
]
okular = [
  { run = 'okular %s', orphan = true, desc = "Okular", for = "linux" },
]

[open]
prepend_rules = [
  { mime = "folder/*", use = [ "strata", "open", "reveal" ] },
  { mime = "text/*", use = [ "edit", "nvim", "reveal" ] },
  { mime = "image/*", use = [ "open", "imv", "reveal" ] },
  { mime = "{audio,video}/*", use = [ "play", "mpv", "reveal" ] },
  { mime = "application/{pdf,epub+zip,x-mobipocket-ebook}", use = [ "okular", "open", "reveal" ] },
]
{{ end }}

[plugin]
prepend_fetchers = [
  { url = "*", run = "git", group = "git" },
  { url = "*/", run = "git", group = "git" },
]

prepend_preloaders = [
  { mime = "{audio,video,image}/*", run = "mediainfo" },
  { mime = "application/{subrip,postscript,illustrator,dvb.ait,vnd.adobe.illustrator,eps}", run = "mediainfo" },
  { url = "*.{ai,eps,ait}", run = "mediainfo" },
]

prepend_previewers = [
  { mime = "{audio,video,image}/*", run = "mediainfo" },
  { mime = "application/{subrip,postscript,illustrator,dvb.ait,vnd.adobe.illustrator,eps}", run = "mediainfo" },
  { url = "*.{ai,eps,ait}", run = "mediainfo" },
{{ if ne .chezmoi.os "windows" }}
  # `ansi` makes bat follow the terminal palette, which DMS themes. glow uses the DMS style
  # generated by matugen (it ignores `$t`, which Ghostty can report as light on a dark theme).
  { url = "*.{ini,inf}", run = 'piper -- bat -p --color=always --theme=ansi --language=INI "$1"' },
  { url = "*.{csv,tsv}", run = 'piper -- bat -p --color=always --theme=ansi "$1"' },
  { url = "*.{md,markdown,mdx}", run = 'piper -- CLICOLOR_FORCE=1 glow -w=$w -s="$([ -f "$HOME/.config/glow/styles/dms.json" ] && echo "$HOME/.config/glow/styles/dms.json" || echo dark)" "$1"' },
{{ end }}
  { mime = "application/{*zip,tar,bzip2,7z*,rar,xz,zstd,java-archive}", run = "ouch --show-file-icons" },
]
