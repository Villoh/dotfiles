{
  "base": "<* if {{ is_dark_mode }} *>dark<* else *>light<* endif *>",
  "colors": {
    "window": "{{colors.surface.default.hex}}",
    "panel": "{{colors.surface_container_low.default.hex}}",
    "surface": "{{colors.surface_container.default.hex}}",
    "surface_hover": "{{colors.surface_container_low.default.hex | auto_lightness: 8.0}}",
    "surface_active": "{{colors.surface_container_low.default.hex | auto_lightness: 16.0}}",
    "outline": "{{colors.outline_variant.default.hex}}",
    "text": "{{colors.on_surface.default.hex}}",
    "secondary": "{{colors.on_surface_variant.default.hex_alpha | set_alpha: 0.85}}",
    "dim": "{{colors.on_surface_variant.default.hex_alpha | set_alpha: 0.7}}",
    "accent": "{{colors.primary.default.hex}}",
    "accent_hover": "{{colors.primary.default.hex | lighten: 6.0}}",
    "on_accent": "{{colors.on_primary.default.hex}}",
    "danger": "{{colors.error.default.hex}}",
    "warning": "{{dank16.color3.default.hex}}",
    "overlay": "{{colors.surface_container_high.default.hex}}",
    "bubble_in": "{{colors.surface_container_high.default.hex}}",
    "bubble_out": "{{colors.primary_container.default.hex}}",
    "link": "{{colors.tertiary.default.hex}}"
  }
}
