{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "dankcolors",
  "colors": {
    "accent": "{{colors.primary.default.hex}}",
    "border": "{{colors.outline.default.hex}}",
    "borderAccent": "{{colors.primary.default.hex}}",
    "borderMuted": "{{colors.outline.default.hex}}",
    "success": "{{dank16.color2.default.hex}}",
    "error": "{{dank16.color1.default.hex}}",
    "warning": "{{dank16.color3.default.hex}}",
    "muted": "{{colors.on_surface_variant.default.hex}}",
    "dim": "{{colors.outline.default.hex}}",
    "text": "{{colors.on_surface.default.hex}}",
    "thinkingText": "{{colors.on_surface_variant.default.hex}}",
    "selectedBg": "{{colors.primary_container.default.hex}}",
    "scrollbarTrack": "{{colors.surface.default.hex}}",
    "scrollbarThumb": "{{colors.outline.default.hex}}",
    "searchMatchBg": "{{colors.primary_container.default.hex}}",
    "searchMatchText": "{{colors.on_primary_container.default.hex}}",
    "userMessageBg": "{{colors.surface_container_high.default.hex}}",
    "userMessageText": "{{colors.on_surface.default.hex}}",
    "customMessageBg": "{{colors.surface_container_high.default.hex}}",
    "customMessageText": "{{colors.on_surface.default.hex}}",
    "customMessageLabel": "{{dank16.color6.default.hex}}",
    "toolPendingBg": "{{colors.surface_container_high.default.hex}}",
    "toolSuccessBg": "{{colors.surface_container_high.default.hex}}",
    "toolErrorBg": "<* if {{ is_dark_mode }} *>{{colors.error.default.hex | set_lightness: 32.0}}<* else *>{{colors.error_container.default.hex}}<* endif *>",
    "toolTitle": "{{colors.on_surface.default.hex}}",
    "toolOutput": "{{colors.on_surface_variant.default.hex}}",
    "mdHeading": "{{colors.primary.default.hex}}",
    "mdLink": "{{colors.primary.default.hex}}",
    "mdLinkUrl": "{{dank16.color12.default.hex}}",
    "mdCode": "{{dank16.color11.default.hex}}",
    "mdCodeBlock": "{{colors.on_surface_variant.default.hex}}",
    "mdCodeBlockBorder": "{{colors.outline.default.hex}}",
    "mdQuote": "{{colors.on_surface_variant.default.hex}}",
    "mdQuoteBorder": "{{dank16.color12.default.hex}}",
    "mdHr": "{{colors.outline.default.hex}}",
    "mdListBullet": "{{dank16.color13.default.hex}}",
    "toolDiffAdded": "{{dank16.color2.default.hex}}",
    "toolDiffRemoved": "{{dank16.color1.default.hex}}",
    "toolDiffContext": "{{colors.on_surface_variant.default.hex}}",
    "syntaxComment": "{{colors.on_surface_variant.default.hex}}",
    "syntaxKeyword": "{{colors.primary.default.hex}}",
    "syntaxFunction": "{{dank16.color12.default.hex}}",
    "syntaxVariable": "{{colors.on_surface.default.hex}}",
    "syntaxString": "{{dank16.color10.default.hex}}",
    "syntaxNumber": "{{dank16.color9.default.hex}}",
    "syntaxType": "{{dank16.color13.default.hex}}",
    "syntaxOperator": "{{colors.on_surface_variant.default.hex}}",
    "syntaxPunctuation": "{{dank16.color14.default.hex}}",
    "thinkingOff": "{{colors.outline.default.hex}}",
    "thinkingMinimal": "{{dank16.color6.default.hex}}",
    "thinkingLow": "{{dank16.color10.default.hex}}",
    "thinkingMedium": "{{dank16.color11.default.hex}}",
    "thinkingHigh": "{{dank16.color12.default.hex}}",
    "thinkingXhigh": "{{dank16.color13.default.hex}}",
    "bashMode": "{{dank16.color11.default.hex}}"
  },
  "export": {
    "pageBg": "{{colors.surface.default.hex}}",
    "cardBg": "{{colors.surface_container_high.default.hex}}",
    "infoBg": "{{colors.surface_container_high.default.hex}}"
  }
}
