{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "{{colors.on_surface.default.hex}}",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "{{colors.primary.default.hex}}",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{colors.on_primary.default.hex}}",
    "background_color": "{{colors.primary.default.hex}}",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "{{colors.secondary.default.hex}}",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "{{colors.outline_variant.default.hex}}",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "{{colors.tertiary.default.hex}}",
    "underline": true
  },
  "link_text": {
    "color": "{{colors.primary.default.hex}}",
    "bold": true
  },
  "image": {
    "color": "{{colors.tertiary.default.hex}}",
    "underline": true
  },
  "image_text": {
    "color": "{{colors.outline.default.hex}}",
    "format": "Image: {{ "{{.text}}" }} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{dank16.color1.default.hex}}",
    "background_color": "{{colors.surface_container_highest.default.hex}}"
  },
  "code_block": {
    "color": "{{colors.on_surface_variant.default.hex}}",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "{{colors.on_surface.default.hex}}"
      },
      "error": {
        "color": "{{colors.on_error.default.hex}}",
        "background_color": "{{colors.error.default.hex}}"
      },
      "comment": {
        "color": "{{colors.outline.default.hex}}"
      },
      "comment_preproc": {
        "color": "{{dank16.color1.default.hex}}"
      },
      "keyword": {
        "color": "{{dank16.color12.default.hex}}"
      },
      "keyword_reserved": {
        "color": "{{dank16.color12.default.hex}}"
      },
      "keyword_namespace": {
        "color": "{{dank16.color1.default.hex}}"
      },
      "keyword_type": {
        "color": "{{dank16.color6.default.hex}}"
      },
      "operator": {
        "color": "{{colors.on_surface_variant.default.hex}}"
      },
      "punctuation": {
        "color": "{{colors.on_surface_variant.default.hex}}"
      },
      "name": {
        "color": "{{colors.on_surface.default.hex}}"
      },
      "name_builtin": {
        "color": "{{dank16.color6.default.hex}}"
      },
      "name_tag": {
        "color": "{{dank16.color1.default.hex}}"
      },
      "name_attribute": {
        "color": "{{dank16.color3.default.hex}}"
      },
      "name_class": {
        "color": "{{dank16.color6.default.hex}}",
        "underline": true,
        "bold": true
      },
      "name_constant": {},
      "name_decorator": {
        "color": "{{dank16.color3.default.hex}}"
      },
      "name_exception": {},
      "name_function": {
        "color": "{{colors.primary.default.hex}}"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "{{dank16.color3.default.hex}}"
      },
      "literal_date": {},
      "literal_string": {
        "color": "{{dank16.color2.default.hex}}"
      },
      "literal_string_escape": {
        "color": "{{dank16.color10.default.hex}}"
      },
      "generic_deleted": {
        "color": "{{dank16.color1.default.hex}}"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "{{dank16.color2.default.hex}}"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "{{colors.outline.default.hex}}"
      },
      "background": {
        "background_color": "{{colors.surface_container_highest.default.hex}}"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
