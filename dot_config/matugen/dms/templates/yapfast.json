{
  "name": "DMS",
  "base": "<* if {{ is_dark_mode }} *>yap<* else *>catppuccin-latte<* endif *>",
  "dark": <* if {{ is_dark_mode }} *>true<* else *>false<* endif *>,
  "colours": {
    "rail": "{{colors.surface_container_lowest.default.hex}}",
    "sidebar": "{{colors.surface_container_low.default.hex}}",
    "panel": "{{colors.surface_container_lowest.default.hex}}",
    "chat": "{{colors.surface.default.hex}}",
    "stage": "{{colors.surface.default.hex}}",
    "raised": "{{colors.surface_container.default.hex}}",
    "field": "{{colors.surface_container_high.default.hex}}",
    "sunken": "{{colors.surface_container_lowest.default.hex}}",
    "hover": "{{colors.surface_container_high.default.hex}}",
    "active": "{{colors.surface_container_highest.default.hex}}",
    "row-hover": "{{colors.surface_container_low.default.hex}}",
    "line": "{{colors.outline_variant.default.hex}}",
    "edge": "{{colors.surface_container_lowest.default.hex}}",
    "text": "{{colors.on_surface.default.hex}}",
    "secondary": "{{colors.on_surface_variant.default.hex}}",
    "muted": "{{colors.outline.default.hex}}",
    "faint": "{{colors.outline.default.hex_alpha | set_alpha: 0.7}}",
    "accent": "{{colors.primary.default.hex}}",
    "accent-hover": "{{colors.primary.default.hex | lighten: 6.0}}",
    "on-accent": "{{colors.on_primary.default.hex}}",
    "accent-soft": "{{colors.primary.default.hex_alpha | set_alpha: 0.15}}",
    "danger": "{{colors.error.default.hex}}",
    "danger-hover": "{{colors.error.default.hex | lighten: 6.0}}",
    "on-danger": "{{colors.on_error.default.hex}}",
    "live": "{{dank16.color2.default.hex}}",
    "loud": "{{dank16.color3.default.hex}}",
    "link": "{{colors.tertiary.default.hex}}",
    "button-default": "{{colors.surface_container_highest.default.hex}}",
    "button-default-hover": "{{colors.surface_container_highest.default.hex | lighten: 6.0}}",
    "overlay": "<* if {{ is_dark_mode }} *>#ffffff<* else *>#000000<* endif *>",
    "shimmer": "<* if {{ is_dark_mode }} *>#ffffff10<* else *>#ffffff66<* endif *>",
    "reply-spine": "{{colors.outline_variant.default.hex}}",
    "tooltip": "{{colors.surface_container_lowest.default.hex}}",
    "avatar": "{{colors.outline.default.hex}}"
  }
}
