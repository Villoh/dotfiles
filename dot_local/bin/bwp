#!/usr/bin/env bash
set -o pipefail

# Bitwarden Plus: shell-independent helpers around Bitwarden CLI.

session_file="${XDG_RUNTIME_DIR:-/tmp}/bwp-${UID}.session"

_save_session() {
  local session="$1"
  [ -n "$session" ] || return 1
  umask 077
  printf '%s\n' "$session" > "$session_file" && chmod 600 "$session_file"
}

_load_session() {
  if [ -n "${BW_SESSION:-}" ]; then
    printf '%s\n' "$BW_SESSION"
  elif [ -r "$session_file" ]; then
    cat "$session_file"
  fi
}

# Route authenticated commands through session stored outside caller shell.
bw() {
  case "${1:-}" in
    login|unlock)
      command bw "$@"
      ;;
    *)
      local session
      session=$(_load_session)
      if [ -n "$session" ]; then
        BW_SESSION="$session" command bw "$@"
      else
        command bw "$@"
      fi
      ;;
  esac
}

# Bitwarden CLI commands
# ============================================================

#region ── Session Management ──────────────────────────────

# Internal helper: returns current vault status
# Outputs: unauthenticated | locked | unlocked
_bw_status() {
  bw status | jq -r '.status'
}

# Unlock the vault and set the session key
# If not logged in, runs bw login first automatically
bwu() {
  local status session
  status=$(_bw_status)
  if [ "$status" = "unauthenticated" ]; then
    echo "Not logged in — running bw login first..."
    session=$(bw login --raw) || return
  else
    session=$(bw unlock --raw) || return
  fi
  _save_session "$session"
  echo "✓ Vault unlocked"
}

# Sync with the server and unlock in a single step
# If not logged in, runs bw login first automatically
bwstart() {
  bwu && bw sync
}

# Log in to Bitwarden with the chosen authentication method
# Saves the session key automatically after login
# Usage:
#   bwp login            → login with email and password
#   bwp login --sso      → login via SSO
#   bwp login --apikey   → login via API Key
bwlogin() {
  local session
  case "${1:-}" in
    --sso)    session=$(bw login --sso --raw) || return ;;
    --apikey) session=$(bw login --apikey --raw) || return ;;
    *)        session=$(bw login --raw) || return ;;
  esac
  _save_session "$session" && echo "✓ Session started"
}

# Manage the Bitwarden server configuration
# Usage:
#   bwp config                              → show current server
#   bwp config "https://my-server.com"      → set server
#   bwp config "https://vault.bitwarden.eu" → EU server
#   bwp config --reset                      → restore official server
bwconfig() {
  case "$1" in
    --reset)
      bw config server https://vault.bitwarden.com
      echo "✓ Server restored to vault.bitwarden.com"
      echo "! Remember to run 'bwp login' again"
      ;;
    "")
      echo "Current server: $(bw config server)"
      ;;
    *)
      bw config server "$1"
      echo "✓ Server set to: $1"
      echo "! Remember to run 'bwp login' again"
      ;;
  esac
}

# Lock the vault and remove the runtime session
bwlock() {
  bw lock
  local status=$?
  rm -f "$session_file"
  return "$status"
}

# Sync the vault with the server
bwsync() {
  bw sync
}

#endregion

#region ── List & Search ───────────────────────────────────

# List vault items with fzf support for bulk actions
# Usage:
#   bwp list                              → list all items
#   bwp list --list-trash                 → list trashed items
#   bwp list --folder "id"                → list items in a folder
#   bwp list --trash                      → select with fzf and move to trash
#   bwp list --delete                     → select with fzf and delete permanently
#   bwp list --folder "id" --trash        → select items in folder with fzf and move to trash
#   bwp list --folder "id" --delete       → select items in folder with fzf and delete permanently
unalias bwls 2>/dev/null
bwls() {
  local folderid="" action="" list_trash=0

  bw sync > /dev/null

  while [ $# -gt 0 ]; do
    case "$1" in
      --folder)     folderid="$2"; shift 2 ;;
      --trash)      action="trash";  shift ;;
      --delete)     action="delete"; shift ;;
      --list-trash) list_trash=1;    shift ;;
      *) echo "✗ Unknown argument: $1"; return 1 ;;
    esac
  done

  if [ "$list_trash" -eq 1 ]; then
    bw list items --trash | jq -r '.[] | "\(.id) — \(.name) — \(.login.username)"'
    return
  fi

  local items
  if [ -n "$folderid" ]; then
    items=$(bw list items --folderid "$folderid" | jq -r '.[] | "\(.id) \(.name) — \(.login.username)"')
  else
    items=$(bw list items | jq -r '.[] | "\(.id) \(.name) — \(.login.username)"')
  fi

  case "$action" in
    trash)
      local ids=$(echo "$items" | fzf --multi | awk '{print $1}')
      [ -z "$ids" ] && return 1
      echo "$ids" | xargs -I {} bw delete item {}
      echo "✓ Items moved to trash"
      ;;
    delete)
      local ids=$(echo "$items" | fzf --multi | awk '{print $1}')
      [ -z "$ids" ] && return 1
      echo "$ids" | xargs -I {} bw delete item {} --permanent
      echo "✓ Items permanently deleted"
      ;;
    *)
      echo "$items" | sed 's/^[^ ]* //' | sort
      ;;
  esac
}

# Search items by name, user, URL or ID with support for actions
# Filters can be combined with each other
# Usage:
#   bwp find --id "item-id"
#   bwp find --id "item-id" --show
#   bwp find --id "item-id" --copy
#   bwp find --name "github"
#   bwp find --user "you@email.com"
#   bwp find --url "github.com"
#   bwp find --name "github" --user "you@email.com"             → combined filters
#   bwp find --name "github" --show                             → show all fields
#   bwp find --name "github" --show password                    → show specific field
#   bwp find --name "github" --show attachment                  → list item attachments
#   bwp find --name "github" --copy                             → copy password to clipboard
#   bwp find --name "github" --copy username                    → copy specific field
#   bwp find --name "github" --copy attachment "name" "path"    → download attachment
#   bwp find --name "github" --exposed                          → check for security breaches
#   bwp find --name "github" --trash                            → move to trash with fzf
#   bwp find --name "github" --delete                           → delete with fzf
bwfind() {
  local id="" name="" user="" url="" action="" field="" attachment_name="" attachment_output=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --id)    id="$2";    shift 2 ;;
      --name)  name="$2";  shift 2 ;;
      --user)  user="$2";  shift 2 ;;
      --url)   url="$2";   shift 2 ;;
      --show)
        action="show"
        if [ -n "$2" ] && [[ "$2" != --* ]]; then
          field="$2"; shift
        fi
        shift
        ;;
      --copy)
        action="copy"
        if [ -n "$2" ] && [[ "$2" != --* ]]; then
          field="$2"
          if [ "$field" = "attachment" ]; then
            [ -n "$3" ] && [[ "$3" != --* ]] && attachment_name="$3" && shift
            [ -n "$4" ] && [[ "$4" != --* ]] && attachment_output="$4" && shift
          fi
          shift
        else
          field="password"
        fi
        shift
        ;;
      --exposed) action="exposed"; shift ;;
      --trash)   action="trash";   shift ;;
      --delete)  action="delete";  shift ;;
      *) echo "✗ Unknown argument: $1"; return 1 ;;
    esac
  done

  if [ -z "$id" ] && [ -z "$name" ] && [ -z "$user" ] && [ -z "$url" ]; then
    echo "✗ You must specify at least one filter: --id, --name, --user or --url"
    return 1
  fi

  local results=""
  if [ -n "$id" ]; then
    results="$id"
  else
    # Build jq filter combining the provided criteria using --arg to avoid injection
    local filter='.[]'
    local jq_args=()
    [ -n "$name" ] && filter+=' | select(.name | ascii_downcase | contains($name))' && jq_args+=(--arg name "${name,,}")
    [ -n "$user" ] && filter+=' | select(.login.username == $user)'                 && jq_args+=(--arg user "$user")
    [ -n "$url"  ] && filter+=' | select(.login.uris != null and (.login.uris[] | .uri | contains($url)))' && jq_args+=(--arg url "$url")

    results=$(bw list items | jq "${jq_args[@]}" -r "[${filter}] | .[] | \"\(.id) \(.name) — \(.login.username)\"")

    if [ -z "$results" ]; then
      echo "✗ No items found"
      return 1
    fi
  fi

  # Select item — if only one result select directly, otherwise use fzf
  _select_item() {
    if [ -n "$id" ]; then
      echo "$id"
    elif [ "$(echo "$results" | wc -l)" -eq 1 ]; then
      echo "$results" | awk '{print $1}'
    else
      echo "$results" | fzf | awk '{print $1}'
    fi
  }

  case "$action" in
    show)
      local id=$(_select_item)
      [ -z "$id" ] && return 1
      if [ -z "$field" ]; then
        bw get item "$id" | jq '{
          id: .id,
          name: .name,
          username: .login.username,
          password: .login.password,
          uris: [.login.uris[]?.uri],
          totp: .login.totp,
          notes: .notes
        }'
      elif [ "$field" = "attachment" ]; then
        bw get item "$id" | jq -r '.attachments[]? | "\(.id) — \(.fileName) — \(.sizeName)"'
      else
        bw get "$field" "$id"
      fi
      ;;
    copy)
      local id=$(_select_item)
      [ -z "$id" ] && return 1
      if [ "$field" = "attachment" ]; then
        [ -z "$attachment_name" ] && echo "✗ You must specify the attachment name with --copy attachment 'name'" && return 1
        local bw_args=(get attachment "$attachment_name" --itemid "$id")
        [ -n "$attachment_output" ] && bw_args+=(--output "$attachment_output")
        bw "${bw_args[@]}" && echo "✓ Attachment downloaded"
      else
        bw get "$field" "$id" | wl-copy
        echo "✓ $field copied to clipboard"
      fi
      ;;
    exposed)
      local id=$(_select_item)
      [ -z "$id" ] && return 1
      local count=$(bw get exposed "$id")
      if [ "$count" -gt 0 ]; then
        echo "⚠ Password found in $count security breaches"
      else
        echo "✓ Password not found in any security breach"
      fi
      ;;
    trash)
      local ids=$(echo "$results" | fzf --multi | awk '{print $1}')
      [ -z "$ids" ] && return 1
      echo "$ids" | xargs -I {} bw delete item {}
      echo "✓ Items moved to trash"
      ;;
    delete)
      local ids=$(echo "$results" | fzf --multi | awk '{print $1}')
      [ -z "$ids" ] && return 1
      echo "$ids" | xargs -I {} bw delete item {} --permanent
      echo "✓ Items permanently deleted"
      ;;
    *)
      if [ -n "$id" ]; then
        bw get item "$id" | jq '.'
      else
        echo "$results" | sort
      fi
      ;;
  esac
}

# Show the full details of an item by ID in readable JSON
# Usage: bwp item "id"
bwitem() {
  if [ -z "$1" ]; then
    echo "✗ You must specify an ID"
    return 1
  fi
  bw get item "$1" | jq '.'
}

#endregion

#region ── Edit & Move ─────────────────────────────────────

# Edit an item, folder, collection or item-collections interactively
# Shows current values as defaults — leave empty to keep the current value
# Usage:
#   bwp edit item "id"             → edit a login item fields interactively
#   bwp edit folder "id"           → rename a folder
#   bwp edit org-collection "id"   → rename a collection
#   bwp edit item-collections "id" → edit collections an item belongs to
bwedit() {
  local type="$1" id="$2"

  if [ -z "$type" ] || [ -z "$id" ]; then
    echo "✗ Usage: bwp edit (item|folder|org-collection|item-collections) \"id\""
    return 1
  fi

  case "$type" in
    item)
      local current=$(bw get item "$id")
      local cur_name=$(echo $current     | jq -r '.name')
      local cur_username=$(echo $current | jq -r '.login.username // ""')
      local cur_password=$(echo $current | jq -r '.login.password // ""')
      local cur_uri=$(echo $current      | jq -r '.login.uris[0].uri // ""')
      local cur_notes=$(echo $current    | jq -r '.notes // ""')

      read -r -p "Name [$cur_name]: " name
      read -r -p "Username [$cur_username]: " username
      read -r -p "Password (leave empty to keep, \"gen\" to generate): " password
      read -r -p "URL [$cur_uri]: " uri
      read -r -p "Notes (leave empty to keep): " notes

      if [ -z "$password" ]; then
        password="$cur_password"
      elif [ "$password" = "gen" ]; then
        password=$(_bwgen_interactive)
        echo "✓ Password generated: $password"
      fi

      name=${name:-$cur_name}
      username=${username:-$cur_username}
      uri=${uri:-$cur_uri}
      notes=${notes:-$cur_notes}

      # Use --arg to safely handle special characters in values
      local updated=$(echo $current | jq \
        --arg name     "$name"     \
        --arg username "$username" \
        --arg password "$password" \
        --arg uri      "$uri"      \
        --arg notes    "$notes"    \
        '.name=$name | .login.username=$username | .login.password=$password | .login.uris[0].uri=$uri | .notes=$notes')

      # Edit existing custom fields
      local fields_count=$(echo "$updated" | jq '(.fields // []) | length')
      if [ "$fields_count" -gt 0 ]; then
        echo "Custom fields:"
        local i=0
        while [ "$i" -lt "$fields_count" ]; do
          local fname=$(echo "$updated" | jq -r ".fields[$i].name")
          local fvalue=$(echo "$updated" | jq -r ".fields[$i].value // \"\"")
          echo "  [$fname] = $fvalue"
          read -r -p "  New value for '$fname' (leave empty to keep): " newval
          if [ -n "$newval" ]; then
            updated=$(echo "$updated" | jq --argjson idx "$i" --arg val "$newval" '.fields[$idx].value = $val')
          fi
          i=$((i + 1))
        done
      fi

      # Add new custom fields
      while true; do
        read -r -p "Add field? (name=value, leave empty to finish): " newfield
        [ -z "$newfield" ] && break
        if [[ "$newfield" == *=* ]]; then
          updated=$(echo "$updated" | jq \
            --arg name  "${newfield%%=*}" \
            --arg value "${newfield#*=}"  \
            '.fields = (.fields // []) + [{"name": $name, "value": $value, "type": 0}]')
        else
          echo "✗ Invalid format, use name=value"
        fi
      done

      echo "$updated" | bw encode | bw edit item "$id" > /dev/null && echo "✓ Item updated successfully"
      ;;

    folder)
      local cur_name=$(bw get folder "$id" | jq -r '.name')
      read -r -p "Folder name [$cur_name]: " fname
      fname=${fname:-$cur_name}

      bw get folder "$id" | jq --arg name "$fname" '.name = $name' | bw encode | bw edit folder "$id" > /dev/null && echo "✓ Folder renamed successfully"
      ;;

    org-collection)
      echo "Available organizations:"
      bw list organizations | jq -r '.[] | "\(.id) — \(.name)"'
      read -r -p "Organization ID: " orgid
      if [ -z "$orgid" ]; then
        echo "✗ Organization ID is required"
        return 1
      fi

      local current=$(bw get org-collection "$id" --organizationid "$orgid")
      local cur_name=$(echo $current | jq -r '.name')
      read -r -p "Collection name [$cur_name]: " cname
      cname=${cname:-$cur_name}

      echo $current | jq --arg name "$cname" '.name = $name' | bw encode | bw edit org-collection "$id" --organizationid "$orgid" > /dev/null && echo "✓ Collection renamed successfully"
      ;;

    item-collections)
      echo "Available collections:"
      bw list org-collections | jq -r '.[] | "\(.id) — \(.name)"'
      echo "Enter collection IDs separated by spaces:"
      read -r collectionids

      local ids_json=$(echo $collectionids | tr ' ' '\n' | jq -R . | jq -s .)
      echo $ids_json | bw encode | bw edit item-collections "$id" > /dev/null && echo "✓ Item collections updated successfully"
      ;;

    *)
      echo "✗ Unknown type: $type. Valid types: item, folder, org-collection, item-collections"
      return 1
      ;;
  esac
}

# Move an item to a different folder interactively
# Usage:
#   bwp move "item-id"              → select destination folder with fzf
#   bwp move "item-id" "folder-id"  → move directly to specified folder
bwmv() {
  local itemid="$1" folderid="$2"

  if [ -z "$itemid" ]; then
    echo "✗ You must specify an item ID"
    return 1
  fi

  if [ -z "$folderid" ]; then
    folderid=$(bw list folders | jq -r '.[] | select(.name != "No Folder") | "\(.id) \(.name)"' | fzf | awk '{print $1}')
    [ -z "$folderid" ] && return 1
  fi

  bw get item "$itemid" | jq --arg fid "$folderid" '.folderId = $fid' | bw encode | bw edit item "$itemid" > /dev/null && echo "✓ Item moved successfully"
}

#endregion

#region ── Attachments ─────────────────────────────────────

# Manage vault attachments
# Usage:
#   bwp attachment --all / -a                                       → list all attachments across all items
#   bwp attachment --itemid "id"                                    → list attachments of an item
#   bwp attachment --add --file "path" --itemid "id"                → add attachment to an item
#   bwp attachment --name "photo.jpg" --itemid "id"                 → download to current directory
#   bwp attachment --name "photo.jpg" --itemid "id" --output "path" → download to specific path
bwattachment() {
  local itemid="" name="" output="" file="" action=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --all|-a)
        bw list items | jq -r '.[] | select(.attachments != null) | .name as $item | .attachments[] | "\($item) — \(.id) — \(.fileName) — \(.sizeName)"'
        return
        ;;
      --itemid) itemid="$2"; shift 2 ;;
      --name)   name="$2";   shift 2 ;;
      --output) output="$2"; shift 2 ;;
      --file)   file="$2";   shift 2 ;;
      --add)    action="add"; shift ;;
      *) echo "✗ Unknown argument: $1"; return 1 ;;
    esac
  done

  if [ -z "$itemid" ]; then
    echo "✗ You must specify --itemid"
    return 1
  fi

  case "$action" in
    add)
      if [ -z "$file" ]; then
        echo "✗ You must specify --file"
        return 1
      fi
      bw create attachment --file "$file" --itemid "$itemid" && echo "✓ Attachment added"
      ;;
    *)
      if [ -z "$name" ]; then
        bw get item "$itemid" | jq -r '.attachments[]? | "\(.id) — \(.fileName) — \(.sizeName)"'
      else
        local bw_args=(get attachment "$name" --itemid "$itemid")
        [ -n "$output" ] && bw_args+=(--output "$output")
        bw "${bw_args[@]}" && echo "✓ Attachment downloaded"
      fi
      ;;
  esac
}

#endregion

#region ── Folders & Collections ──────────────────────────

# Internal helper: creates a folder interactively
# Do not call directly, use bwp folder --add or bwp add
_bwfolder_create() {
  local fname=""
  while [ -z "$fname" ]; do
    read -r -p "Folder name (required): " fname
  done
  bw get template folder | jq --arg name "$fname" '.name = $name' | bw encode | bw create folder > /dev/null && echo "✓ Folder created"
}

# Manage vault folders
# Usage:
#   bwp folder --all / -a       → list all folders
#   bwp folder "id"             → show folder details
#   bwp folder --add            → create a folder interactively
#   bwp folder --delete         → select with fzf and delete
#   bwp folder "id" --delete    → delete specific folder directly
bwfolder() {
  local folderid="" action=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --all|-a)  action="list";   shift ;;
      --add)     action="add";    shift ;;
      --delete)  action="delete"; shift ;;
      *)         folderid="$1";   shift ;;
    esac
  done

  case "$action" in
    list)
      bw list folders | jq -r '.[] | select(.name != "No Folder") | "\(.id) — \(.name)"'
      ;;
    add)
      _bwfolder_create
      ;;
    delete)
      if [ -z "$folderid" ]; then
        folderid=$(bw list folders | jq -r '.[] | select(.name != "No Folder") | "\(.id) \(.name)"' | fzf | awk '{print $1}')
        [ -z "$folderid" ] && return 1
      fi
      bw delete folder "$folderid" && echo "✓ Folder deleted"
      ;;
    *)
      if [ -z "$folderid" ]; then
        echo "✗ You must specify an ID, --all / -a, --add, or --delete"
        return 1
      fi
      bw get folder "$folderid" | jq '.'
      ;;
  esac
}

# Internal helper: creates a collection interactively
# Do not call directly, use bwp collection --add
_bwcollection_create() {
  echo "Available organizations:" >&2
  bw list organizations | jq -r '.[] | "\(.id) — \(.name)"' >&2
  read -r -p "Organization ID: " orgid
  if [ -z "$orgid" ]; then
    echo "✗ Organization ID is required"
    return 1
  fi

  local cname=""
  while [ -z "$cname" ]; do
    read -r -p "Collection name (required): " cname
  done

  read -r -p "External ID (leave empty for none): " externalid

  bw get template collection | jq \
    --arg org  "$orgid"      \
    --arg name "$cname"      \
    --arg ext  "$externalid" \
    '.organizationId=$org | .name=$name | .externalId=(if $ext == "" then null else $ext end)' \
    | bw encode | bw create org-collection --organizationid "$orgid" > /dev/null && echo "✓ Collection created"
}

# Manage organization collections
# Usage:
#   bwp collection --all / -a   → list all collections
#   bwp collection "id"         → show collection details
#   bwp collection --add        → create a collection interactively
bwcollection() {
  case "$1" in
    --all|-a) bw list org-collections | jq -r '.[] | "\(.id) — \(.name)"' ;;
    --add)    _bwcollection_create ;;
    *)
      if [ -z "$1" ]; then
        echo "✗ You must specify an ID, --all / -a, or --add"
        return 1
      fi
      bw get org-collection "$1" | jq '.'
      ;;
  esac
}

#endregion

#region ── Templates ───────────────────────────────────────

# Show available vault templates
# Usage:
#   bwp template --all / -a   → list all available templates
#   bwp template "name"       → show a specific template
bwtemplate() {
  local valid_templates=(item item.field item.login item.login.uri item.card item.identity item.securenote folder collection item-collections org-collection)

  case "$1" in
    --all|-a)
      echo "Available templates:"
      for t in "${valid_templates[@]}"; do
        echo "  • $t"
      done
      ;;
    *)
      if [ -z "$1" ]; then
        echo "✗ You must specify a template or --all / -a"
        return 1
      fi
      bw get template "$1" | jq '.'
      ;;
  esac
}

#endregion

#region ── Add Items ───────────────────────────────────────

# Internal helper: prompts for a folder interactively and returns its ID
# Do not call directly
_bwadd_select_folder() {
  local folders=$(bw list folders | jq '[.[] | select(.name != "No Folder")]')
  local count=$(echo $folders | jq 'length')

  if [ "$count" -gt 0 ]; then
    echo "\nAvailable folders:" >&2
    echo $folders | jq -r 'to_entries[] | "\(.key + 1)) \(.value.name)"' >&2
    read -r -p "Folder number (leave empty for none): " foldernum
    if [ -n "$foldernum" ]; then
      echo $folders | jq -r ".[$foldernum - 1].id"
    fi
  fi
}

# Internal helper: creates a Login item (type=1)
# Removes the totp field from the template to avoid creating an empty TOTP field
_bwadd_login() {
  read -r -p "URL: " uri
  read -r -p "Username: " username
  read -r -p "Generate password? (y/n) [n]: " generate_password
  if [ "$generate_password" = "y" ]; then
    password=$(_bwgen_interactive)
    echo "✓ Password generated" >&2
  else
    read -r -p "Password (leave empty for blank): " password
  fi

  bw get template item.login | jq \
    --arg user "$username" \
    --arg pass "$password" \
    --arg uri  "$uri"      \
    'del(.totp) | .username=$user | .password=$pass | .uris=[{"match":null,"uri":$uri}]'
}

# Internal helper: creates a Card item (type=3)
_bwadd_card() {
  read -r -p "Cardholder name: " cardholder
  read -r -p "Brand (visa/mastercard/amex/discover/diners/jcb/maestro/unionpay): " brand
  read -r -p "Card number: " number
  read -r -p "Expiration month (01-12): " expmonth
  read -r -p "Expiration year: " expyear
  read -r -p "CVV: " code

  bw get template item.card | jq \
    --arg ch  "$cardholder" \
    --arg br  "$brand"      \
    --arg num "$number"     \
    --arg em  "$expmonth"   \
    --arg ey  "$expyear"    \
    --arg cvv "$code"       \
    '.cardholderName=$ch | .brand=$br | .number=$num | .expMonth=$em | .expYear=$ey | .code=$cvv'
}

# Internal helper: creates an Identity item (type=4)
_bwadd_identity() {
  read -r -p "Title (Mr/Mrs/Ms/Dr): " title
  read -r -p "First name: " firstname
  read -r -p "Middle name: " middlename
  read -r -p "Last name: " lastname
  read -r -p "Company: " company
  read -r -p "Email: " email
  read -r -p "Phone: " phone
  read -r -p "Address: " address1
  read -r -p "Address (line 2): " address2
  read -r -p "City: " city
  read -r -p "State/Province: " state
  read -r -p "Postal code: " postalcode
  read -r -p "Country: " country
  read -r -p "Username: " username
  read -r -p "SSN: " ssn
  read -r -p "Passport number: " passport
  read -r -p "Driver's license number: " license

  bw get template item.identity | jq \
    --arg title  "$title"      \
    --arg fn     "$firstname"  \
    --arg mn     "$middlename" \
    --arg ln     "$lastname"   \
    --arg co     "$company"    \
    --arg em     "$email"      \
    --arg ph     "$phone"      \
    --arg a1     "$address1"   \
    --arg a2     "$address2"   \
    --arg ci     "$city"       \
    --arg st     "$state"      \
    --arg pc     "$postalcode" \
    --arg cn     "$country"    \
    --arg un     "$username"   \
    --arg ssn    "$ssn"        \
    --arg pp     "$passport"   \
    --arg lic    "$license"    \
    '.title=$title | .firstName=$fn | .middleName=$mn | .lastName=$ln |
     .company=$co | .email=$em | .phone=$ph |
     .address1=$a1 | .address2=$a2 | .city=$ci | .state=$st |
     .postalCode=$pc | .country=$cn | .username=$un |
     .ssn=$ssn | .passportNumber=$pp | .licenseNumber=$lic'
}

# Internal helper: creates an SSH Key item (type=5)
# No official template available, built manually
_bwadd_sshkey() {
  read -r -p "Private key: " privatekey
  read -r -p "Public key: " publickey
  read -r -p "Fingerprint: " fingerprint

  jq -n \
    --arg priv "$privatekey"  \
    --arg pub  "$publickey"   \
    --arg fp   "$fingerprint" \
    '{"privateKey":$priv,"publicKey":$pub,"fingerprint":$fp}'
}

# Add a new item or folder interactively
# Supports all item types: login, securenote, card, identity, sshkey, folder
# Usage: bwp add
bwadd() {
  echo "Available types:"
  echo "  1) Login"
  echo "  2) Secure Note"
  echo "  3) Card"
  echo "  4) Identity"
  echo "  5) SSH Key"
  echo "  6) Folder"
  read -r -p "Type [1]: " type
  type=${type:-1}

  if [ "$type" = "6" ]; then
    _bwfolder_create
    return
  fi

  local name=""
  while [ -z "$name" ]; do
    read -r -p "Item name (required): " name
  done

  read -r -p "Notes: " notes

  local subobject subfield
  case "$type" in
    1) subfield="login";      subobject=$(_bwadd_login)     ;;
    2) subfield="secureNote"; subobject=$(bw get template item.securenote) ;;
    3) subfield="card";       subobject=$(_bwadd_card)      ;;
    4) subfield="identity";   subobject=$(_bwadd_identity)  ;;
    5) subfield="sshKey";     subobject=$(_bwadd_sshkey)    ;;
    *) echo "✗ Invalid type"; return 1 ;;
  esac

  local folderid=$(_bwadd_select_folder)

  local item=$(bw get template item | jq \
    --argjson type "$type"       \
    --arg     name "$name"       \
    --arg     notes "$notes"     \
    --argjson sub  "$subobject"  \
    ".type=\$type | .name=\$name | .notes=\$notes | .$subfield=\$sub")

  if [ -n "$folderid" ]; then
    item=$(echo $item | jq --arg fid "$folderid" '.folderId = $fid')
  fi

  # Add custom fields
  while true; do
    read -r -p "Add field? (name=value, leave empty to finish): " newfield
    [ -z "$newfield" ] && break
    if [[ "$newfield" == *=* ]]; then
      item=$(echo "$item" | jq \
        --arg name  "${newfield%%=*}" \
        --arg value "${newfield#*=}"  \
        '.fields = (.fields // []) + [{"name": $name, "value": $value, "type": 0}]')
    else
      echo "✗ Invalid format, use name=value"
    fi
  done

  echo $item | bw encode | bw create item > /dev/null && echo "✓ Item created successfully"
}

#endregion

#region ── Generate ────────────────────────────────────────

# Internal helper: generates a password/passphrase interactively and returns it via stdout
# Do not call directly, use bwp generate or bwp add
_bwgen_interactive() {
  local -a args

  read -r -p "Type (password/passphrase) [password]: " type
  type=${type:-password}

  if [ "$type" = "passphrase" ]; then
    read -r -p "Number of words [3]: " words
    args+=(-p --words ${words:-3})

    read -r -p "Separator [_]: " separator
    args+=(--separator ${separator:-_})

    read -r -p "Capitalize? (y/n) [n]: " capitalize
    [ "$capitalize" = "y" ] && args+=(-c)

    read -r -p "Include number? (y/n) [n]: " includenumber
    [ "$includenumber" = "y" ] && args+=(--includeNumber)
  else
    read -r -p "Length [25]: " length
    args+=(--length ${length:-25})

    read -r -p "Uppercase? (y/n) [y]: " uppercase
    [ "${uppercase:-y}" = "y" ] && args+=(-u)

    read -r -p "Lowercase? (y/n) [y]: " lowercase
    [ "${lowercase:-y}" = "y" ] && args+=(-l)

    read -r -p "Numbers? (y/n) [y]: " numbers
    [ "${numbers:-y}" = "y" ] && args+=(-n)

    read -r -p "Special characters? (y/n) [y]: " special
    [ "${special:-y}" = "y" ] && args+=(-s)

    read -r -p "Avoid ambiguous characters? (y/n) [n]: " ambiguous
    [ "$ambiguous" = "y" ] && args+=(--ambiguous)

    read -r -p "Minimum numbers [0]: " minnumber
    [ -n "$minnumber" ] && [ "$minnumber" -gt 0 ] && args+=(--minNumber "$minnumber")

    read -r -p "Minimum special characters [0]: " minspecial
    [ -n "$minspecial" ] && [ "$minspecial" -gt 0 ] && args+=(--minSpecial "$minspecial")
  fi

  bw generate "${args[@]}"
}

# Generate a password/passphrase interactively and copy it to the clipboard
# Usage: bwp generate
bwgen() {
  local generated=$(_bwgen_interactive)
  echo "$generated" | wl-copy
  echo "✓ Password generated and copied: $generated"
}

#endregion

#region ── Delete & Restore ────────────────────────────────

# Move an item to the trash by ID (auto-deleted after 30 days)
# Usage: bwp trash "id"
bwtrash() {
  bw delete item "$1" && echo "✓ Item moved to trash"
}

# Permanently delete an item or folder by ID
# Usage: bwp delete "id" / bwp delete item "id" / bwp delete folder "id"
bwdelete() {
  if [ "$1" = "folder" ]; then
    bw delete folder "$2" && echo "✓ Folder deleted"
  elif [ "$1" = "item" ]; then
    bw delete item "$2" --permanent && echo "✓ Item permanently deleted"
  else
    bw delete item "$1" --permanent && echo "✓ Item permanently deleted"
  fi
}

# Empty the trash by permanently deleting all items in it
bwempty() {
  bw list items --trash | jq -r '.[].id' | xargs -I {} bw delete item {} --permanent
  echo "✓ Trash emptied"
}

# Restore an item from the trash before it is auto-deleted
# Usage: bwp restore "id"
bwrestore() {
  bw restore item "$1" && echo "✓ Item restored"
}

#endregion

_usage() {
  cat <<'EOF'
Usage: bwp <command> [arguments]

Session:
  unlock, start, login, lock, sync, status

Vault:
  list, find, item, edit, move, attachment
  folder, collection, template, add, generate
  config, trash, delete, empty, restore
EOF
}

case "${1:-}" in
  unlock)     shift; bwu "$@" ;;
  start)      shift; bwstart "$@" ;;
  login)      shift; bwlogin "$@" ;;
  lock)       shift; bwlock "$@" ;;
  sync)       shift; bwsync "$@" ;;
  status)     shift; _bw_status "$@" ;;
  config)     shift; bwconfig "$@" ;;
  list|ls)    shift; bwls "$@" ;;
  find)       shift; bwfind "$@" ;;
  item)       shift; bwitem "$@" ;;
  edit)       shift; bwedit "$@" ;;
  move|mv)    shift; bwmv "$@" ;;
  attachment) shift; bwattachment "$@" ;;
  folder)     shift; bwfolder "$@" ;;
  collection) shift; bwcollection "$@" ;;
  template)   shift; bwtemplate "$@" ;;
  add)        shift; bwadd "$@" ;;
  generate|gen) shift; bwgen "$@" ;;
  trash)      shift; bwtrash "$@" ;;
  delete)     shift; bwdelete "$@" ;;
  empty)      shift; bwempty "$@" ;;
  restore)    shift; bwrestore "$@" ;;
  help|-h|--help|"") _usage ;;
  *) echo "Unknown command: $1" >&2; _usage >&2; exit 2 ;;
esac
