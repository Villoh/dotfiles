#!/usr/bin/env bash
set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

BACKUP_DIR="$(chezmoi source-path)/packages/linux"
mkdir -p "${BACKUP_DIR}"

# ── Helpers ────────────────────────────────────────────────────────────────────

save_existing_backup() {
    local path="$1"
    mkdir -p "$(dirname "$path")"
    if [ -f "$path" ]; then
        cp "$path" "${path}.bak"
    fi
}

# ── Backup functions ───────────────────────────────────────────────────────────

backup_pacman() {
    if ! command -v pacman >/dev/null 2>&1; then
        echo -e "${YELLOW}⚠️  Pacman not installed, skipping${NC}\n"
        return 0
    fi
    echo -e "${GREEN}📦 Pacman packages (explicit):${NC}"
    save_existing_backup "${BACKUP_DIR}/pacman/pacman.txt"
    pacman -Qqe > "${BACKUP_DIR}/pacman/pacman.txt"
    echo -e "  ${YELLOW}→ $(wc -l < "${BACKUP_DIR}/pacman/pacman.txt") packages saved to pacman/pacman.txt${NC}\n"
}

backup_aur() {
    if ! command -v pacman >/dev/null 2>&1; then
        echo -e "${YELLOW}⚠️  Pacman not installed, skipping${NC}\n"
        return 0
    fi
    echo -e "${GREEN}🔧 AUR packages:${NC}"
    save_existing_backup "${BACKUP_DIR}/aur.txt"
    pacman -Qqm > "${BACKUP_DIR}/aur.txt"
    echo -e "  ${YELLOW}→ $(wc -l < "${BACKUP_DIR}/aur.txt") packages saved to aur.txt${NC}\n"
}

backup_flatpak() {
    if command -v flatpak >/dev/null 2>&1; then
        echo -e "${GREEN}📱 Flatpak packages:${NC}"
        save_existing_backup "${BACKUP_DIR}/flatpak.txt"
        flatpak list --app --columns=application 2>/dev/null > "${BACKUP_DIR}/flatpak.txt" || echo "" > "${BACKUP_DIR}/flatpak.txt"
        echo -e "  ${YELLOW}→ $(wc -l < "${BACKUP_DIR}/flatpak.txt") packages saved to flatpak.txt${NC}\n"
    else
        echo -e "${YELLOW}⚠️  Flatpak not installed, skipping${NC}\n"
    fi
}

backup_brew() {
    if command -v brew >/dev/null 2>&1; then
        echo -e "${GREEN}🍺 Brew packages:${NC}"
        save_existing_backup "${BACKUP_DIR}/brew.txt"
        brew leaves > "${BACKUP_DIR}/brew.txt" || echo "" > "${BACKUP_DIR}/brew.txt"
        echo -e "  ${YELLOW}→ $(wc -l < "${BACKUP_DIR}/brew.txt") packages saved to brew.txt${NC}\n"
    else
        echo -e "${YELLOW}⚠️  Brew not installed, skipping${NC}\n"
    fi
}

backup_omarchy() {
    local plugins_dir="$HOME/.config/omarchy/plugins"
    local file="$BACKUP_DIR/omarchy-plugins.txt"
    local dir url changes
    local -a urls=()

    if [[ ! -d "$plugins_dir" ]]; then
        echo -e "${YELLOW}⚠️  Omarchy plugins directory not found, skipping${NC}\n"
        return 0
    fi

    for dir in "$plugins_dir"/*; do
        [[ -d "$dir" ]] || continue
        if [[ ! -e "$dir/.git" ]]; then
            echo "⚠️  ${dir##*/}: not a Git repository; back up this plugin separately" >&2
            continue
        fi
        if ! url=$(git -C "$dir" remote get-url origin) || [[ -z "$url" ]]; then
            echo "❌ ${dir##*/}: cannot read origin; keeping previous inventory" >&2
            return 1
        fi
        changes=$(git -C "$dir" status --porcelain) || return 1
        if [[ -n "$changes" ]]; then
            echo "⚠️  ${dir##*/}: local changes are NOT included in the repository list" >&2
        fi
        urls+=("$url")
    done

    save_existing_backup "$file"
    printf '%s\n' "${urls[@]}" | sort -u | sed '/^$/d' > "$file"
    echo -e "${GREEN}🧩 Omarchy: ${#urls[@]} plugin repositories saved to omarchy-plugins.txt${NC}"
}

backup_herdr() {
    local file="$BACKUP_DIR/herdr-plugins.json"
    local registry inventory
    if ! command -v herdr >/dev/null 2>&1; then
        echo -e "${YELLOW}⚠️  Herdr not installed, skipping${NC}"
        return 0
    fi

    registry=$(herdr plugin list --json) || return 1
    inventory=$(jq -e --arg home "$HOME/" '
        .result.plugins
        | if type != "array" then error("Invalid Herdr plugin list") else . end
        | map({
            id: .plugin_id, enabled, kind: .source.kind,
            source: (if .source.kind == "github" then
                [.source.owner, .source.repo, .source.subdir]
                | map(select(. != null and . != "")) | join("/")
            elif .source.kind == "local" then
                .plugin_root | if startswith($home) then ltrimstr($home)
                else error("Local plugin outside HOME: back it up separately") end
            else error("Unknown Herdr plugin source") end),
            ref: null
        }) | sort_by(.id)
    ' <<< "$registry") || return 1

    save_existing_backup "$file"
    printf '%s\n' "$inventory" > "$file"
    echo -e "${GREEN}🧩 Herdr plugin inventory saved to herdr-plugins.json${NC}"
}

run_all() {
    backup_pacman
    backup_aur
    backup_flatpak
    backup_brew
    backup_omarchy
    backup_herdr
}

# ── Entry point ────────────────────────────────────────────────────────────────

if [[ $# -eq 0 ]]; then
    echo -e "${BLUE}📦 Backing up installed packages...${NC}\n"
    run_all
    echo -e "${GREEN}✅ Backup completed!${NC}"
    echo -e "${BLUE}📁 Location: ${BACKUP_DIR}${NC}"
    exit 0
fi

# Individual flags — can be combined: backup-packages --pacman --aur --flatpak
HANDLED=false
for arg in "$@"; do
    case "$arg" in
        --pacman)  backup_pacman;  HANDLED=true ;;
        --aur)     backup_aur;     HANDLED=true ;;
        --flatpak) backup_flatpak; HANDLED=true ;;
        --brew)       backup_brew;       HANDLED=true ;;
        --omarchy)    backup_omarchy;    HANDLED=true ;;
        --herdr)      backup_herdr;      HANDLED=true ;;
        --interactive|-i) : ;;  # handled below
        *) echo -e "${YELLOW}⚠️  Unknown flag: $arg${NC}" >&2; exit 2 ;;
    esac
done

[[ "$HANDLED" == true ]] && exit 0

if [[ "${1:-}" == "--interactive" || "${1:-}" == "-i" ]]; then
    if ! command -v gum >/dev/null 2>&1; then
        echo -e "${YELLOW}⚠️  gum not installed. Install with: sudo pacman -S gum${NC}" >&2
        exit 1
    fi

    gum style \
        --foreground 75 \
        --border-foreground 75 \
        --border double \
        --align center \
        --width 60 \
        --margin "1 2" \
        --padding "2 4" \
        '📦  BACKUP PACKAGES  📦' \
        '' \
        'Selecciona qué gestores quieres hacer backup'

    SELECTED=$(gum choose \
        --no-limit \
        --cursor.foreground="75" \
        --selected.foreground="75" \
        --header="Espacio para seleccionar, Enter para confirmar" \
        --header.foreground="245" \
        "📦 pacman" \
        "🔧 aur" \
        "📱 flatpak" \
        "🍺 brew" \
        "🧩 omarchy" \
        "🧩 herdr")

    if [ -z "$SELECTED" ]; then
        gum style --foreground 196 "❌ No se seleccionó ninguna opción"
        exit 1
    fi

    echo ""
    echo "$SELECTED" | while IFS= read -r choice; do
        case "$choice" in
            *pacman*)  backup_pacman  ;;
            *aur*)     backup_aur     ;;
            *flatpak*) backup_flatpak ;;
            *brew*)       backup_brew       ;;
            *omarchy*) backup_omarchy ;;
            *herdr*)   backup_herdr ;;
        esac
    done

    gum style \
        --foreground 46 \
        --border-foreground 46 \
        --border double \
        --align center \
        --width 60 \
        "✅ ¡Backup completado!"
fi
