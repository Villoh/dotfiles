#!/usr/bin/env bash
set -u

command_exists() { command -v "$1" >/dev/null 2>&1; }

run_harness_step() {
    local label=$1
    shift
    printf '→ %s\n' "$label"
    if "$@"; then
        printf '  ✓ Done\n'
    else
        printf '  ✗ Failed\n' >&2
        harness_failed=1
    fi
}

run_harness() {
    local harness_failed=0

    if command_exists npx; then
        run_harness_step 'skills.sh skills' npx --yes skills update -g -y
        run_harness_step 'Caveman for OpenCode' npx -y github:JuliusBrussee/caveman -- --only opencode --force --non-interactive
        run_harness_step 'Impeccable' npx impeccable update -y --providers=codex,cursor,opencode,pi --scope=global
    else
        printf '→ Skipping skills.sh, Caveman and Impeccable: npx not found\n' >&2
    fi

    if command_exists ctx7; then
        run_harness_step 'Context7 CLI skills' ctx7 setup --cli --opencode --claude --codex --yes
    else
        printf '→ Skipping Context7: ctx7 not found\n' >&2
    fi

    if command_exists mise; then
        run_harness_step 'headroom' mise upgrade --bump pipx:headroom-ai
        run_harness_step 'serena' mise upgrade --bump pipx:serena-agent
    else
        printf '→ Skipping headroom and serena: mise not found\n' >&2
    fi

    return "$harness_failed"
}

case "${1:-}" in
    --harness)
        [[ $# -eq 1 ]] || { echo 'Usage: update-packages --harness' >&2; exit 2; }
        run_harness
        exit $?
        ;;
    -h|--help)
        cat <<'EOF'
Usage: update-packages [--all | manager...]
       update-packages --harness

Managers: system flatpak brew mise uv npm pnpm bun skills caveman
          impeccable context7 headroom serena
Use --manager or manager; no arguments opens interactive menu.
EOF
        exit 0
        ;;
esac

choices=()
if command_exists yay; then
    choices+=("🔧 system + AUR (yay)")
elif command_exists paru; then
    choices+=("🔧 system + AUR (paru)")
elif command_exists pacman; then
    choices+=("📦 system (pacman)")
fi
command_exists flatpak && choices+=("📱 flatpak")
command_exists brew && choices+=("🍺 brew")
command_exists mise && choices+=("🧰 mise")
command_exists uv && choices+=("🐍 uv tools")
command_exists npm && choices+=("📦 npm globals")
command_exists pnpm && choices+=("📦 pnpm globals")
command_exists bun && choices+=("🍞 bun globals")
command_exists npx && choices+=("🎯 skills.sh")
command_exists npx && choices+=("🦴 caveman (opencode)")
command_exists npx && choices+=("🧩 Impeccable")
command_exists ctx7 && choices+=("📚 Context7 (CLI skills)")
command_exists mise && choices+=("🗜️  headroom")
command_exists mise && choices+=("🧭 serena")

if ((${#choices[@]} == 0)); then
    echo "No supported package manager found." >&2
    exit 1
fi

choice_for() {
    case "$1" in
        system) if command_exists yay; then echo "🔧 system + AUR (yay)"; elif command_exists paru; then echo "🔧 system + AUR (paru)"; elif command_exists pacman; then echo "📦 system (pacman)"; fi ;;
        flatpak) echo "📱 flatpak" ;;
        brew) echo "🍺 brew" ;;
        mise) echo "🧰 mise" ;;
        uv) echo "🐍 uv tools" ;;
        npm) echo "📦 npm globals" ;;
        pnpm) echo "📦 pnpm globals" ;;
        bun) echo "🍞 bun globals" ;;
        skills) echo "🎯 skills.sh" ;;
        caveman) echo "🦴 caveman (opencode)" ;;
        impeccable) echo "🧩 Impeccable" ;;
        context7) echo "📚 Context7 (CLI skills)" ;;
        headroom) echo "🗜️  headroom" ;;
        serena) echo "🧭 serena" ;;
        *) return 1 ;;
    esac
}

if (($#)); then
    selected_choices=()
    for arg in "$@"; do
        manager=${arg#--}
        if [[ "$manager" == all ]]; then
            selected_choices=("${choices[@]}")
            continue
        fi
        if ! choice=$(choice_for "$manager") || [[ ! " ${choices[*]} " == *"$choice"* ]]; then
            echo "Unsupported or unavailable manager: $arg" >&2
            exit 2
        fi
        selected_choices+=("$choice")
    done
    selected=$(printf '%s\n' "${selected_choices[@]}" | awk '!seen[$0]++')
else
    if ! command_exists gum; then
        echo "gum not found. Install with: sudo pacman -S gum" >&2
        exit 1
    fi
    gum style \
        --foreground 75 \
        --border-foreground 75 \
        --border double \
        --align center \
        --width 60 \
        --margin "1 2" \
        --padding "2 4" \
        '📦  UPDATE PACKAGES  📦' \
        '' \
        'Select package managers to update'

    selected=$(gum choose \
        --no-limit \
        --cursor.foreground="75" \
        --selected.foreground="75" \
        --header="SPACE=toggle  ENTER=update" \
        --header.foreground="245" \
        "${choices[@]}")
fi

[[ -z "$selected" ]] && { echo "No package manager selected."; exit 0; }

failed=0
run() {
    local label=$1
    shift
    if command_exists gum; then gum style --foreground 75 --bold "→ $label"; else printf '→ %s\n' "$label"; fi
    if "$@"; then
        if command_exists gum; then gum style --foreground 42 "  ✓ Done"; else printf '  ✓ Done\n'; fi
    else
        if command_exists gum; then gum style --foreground 196 "  ✗ Failed"; else printf '  ✗ Failed\n' >&2; fi
        failed=1
    fi
}

# Keep terminal stdin available to native updater prompts.
while IFS= read -r choice <&3; do
    case "$choice" in
        "🔧 system + AUR (yay)") run "System and AUR" yay -Syu ;;
        "🔧 system + AUR (paru)") run "System and AUR" paru -Syu ;;
        "📦 system (pacman)") run "System" sudo pacman -Syu ;;
        "📱 flatpak") run "Flatpak" flatpak update -y ;;
        "🍺 brew")
            run "Homebrew metadata" brew update
            run "Homebrew packages" brew upgrade
            ;;
        "🧰 mise") run "mise tools" mise upgrade ;;
        "🐍 uv tools") run "uv tools" uv tool upgrade --all ;;
        "📦 npm globals") run "npm global packages" npm update -g ;;
        "📦 pnpm globals") run "pnpm global packages" pnpm update -g --latest ;;
        "🍞 bun globals") run "Bun global packages" bun update -g ;;
        "🎯 skills.sh") run "skills.sh skills" npx --yes skills update -g -y ;;
        "🦴 caveman (opencode)") run "Caveman for OpenCode" npx -y github:JuliusBrussee/caveman -- --only opencode --force --non-interactive ;;
        "🧩 Impeccable") run "Impeccable" npx impeccable update -y --providers=codex,cursor,opencode,pi --scope=global ;;
        "📚 Context7 (CLI skills)") run "Context7 CLI skills" ctx7 setup --cli --opencode --claude --codex --yes ;;
        # Keep Headroom's dependency exclusions in the mise tool configuration.
        "🗜️  headroom") run "headroom" mise upgrade --bump pipx:headroom-ai ;;
        "🧭 serena") run "serena" mise upgrade --bump pipx:serena-agent ;;
    esac
done 3<<< "$selected"

if ((failed)); then
    if command_exists gum; then
        gum style --foreground 196 --border rounded --padding "1 2" "Update completed with errors."
    else
        printf 'Update completed with errors.\n' >&2
    fi
    exit 1
fi

if command_exists gum; then
    gum style --foreground 42 --border rounded --padding "1 2" "Update completed."
else
    printf 'Update completed.\n'
fi
