#!/usr/bin/env bash
# Personal OpenVPN selector. systemd owns processes; NetworkManager/DMS profiles are separate.
set -euo pipefail
shopt -s nullglob

readonly NORDVPN_DIR="${HOME}/.config/openvpn/nordvpn"
readonly VPND_DIR="${HOME}/.config/openvpn/vpnd"
readonly API="https://api.nordvpn.com/v1"

usage() {
  cat <<'HELP'
Uso: ovpn start [servidor [udp|tcp [nordvpn|vpnd]]] [--limit N]
     ovpn stop [nordvpn|vpnd|all]
     ovpn status [nordvpn|vpnd]
     ovpn login
     ovpn creds list
     ovpn creds set    <perfil> | --provider nordvpn|vpnd | --all
     ovpn creds delete <perfil> | --provider nordvpn|vpnd | --all
     ovpn import [--countries es,de|all] [--servers es114,de920] [--protocol udp|tcp]
                 [--per-country N] [--yes]

import precarga perfiles NordVPN en NetworkManager (para verlos en DMS) desde los .ovpn locales.
Por país elige los N servidores con menos carga según la API (defecto 1; sin API, el primero
local). Protocolo por defecto: udp. Pide confirmación por encima de 20 perfiles (--yes la omite).
No hace falta para conectar: ovpn start importa el servidor elegido la primera vez.

creds gestiona el usuario de los perfiles de NetworkManager (<proveedor>-<servidor>-<protocolo>).
set guarda usuario y contraseña (texto plano, solo root) en los perfiles; con la contraseña vacía
solo cambia el usuario. delete borra el perfil entero (la contraseña guardada no se puede quitar
solo con nmcli); ovpn start lo vuelve a importar y a pedir credenciales cuando haga falta.

Opciones (también OVPN_BACKEND / OVPN_AUTH):
  --backend nm|systemd   nm (defecto): perfiles de NetworkManager, los mismos que DMS.
                         systemd: lanza openvpn con systemd-run (sudo, sin DMS).
  --auth dms|file        dms (defecto): usa lo guardado en NetworkManager y pide en el
                         terminal lo que falte. file: lee ~/.config/ovpn/credentials
                         (modo 600, se crea con ovpn login).

Sin servidor, start abre el selector de proveedor, protocolo, país y ciudad.
En modo directo se conservan los valores por defecto: tcp y vpnd.
Los perfiles se leen de ~/.config/openvpn/{nordvpn,vpnd}/ y se importan a
NetworkManager como <proveedor>-<servidor>-<protocolo> la primera vez.
Backend systemd: credenciales en /etc/openvpn/<proveedor>/auth (solo root, modo 600);
logs con journalctl -u openvpn-vpn-<proveedor>.service
Sin kill switch.
HELP
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}
need() { command -v "$1" >/dev/null || die "Falta el comando $1; instálalo mediante NixOS."; }
provider_ok() { [[ $1 == nordvpn || $1 == vpnd ]]; }
unit() { printf 'openvpn-vpn-%s.service' "$1"; }
running() {
  local state
  state=$(systemctl is-active "$(unit "$1")") || :
  case $state in
  active | activating | reloading | deactivating) return 0 ;;
  inactive | failed) return 1 ;;
  *) die "No se pudo consultar el servicio de $1 (estado: ${state:-desconocido})." ;;
  esac
}

CRED_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/ovpn/credentials"
PASSFILE=''
trap '[[ -z $PASSFILE ]] || rm -f -- "$PASSFILE"' EXIT

# Active NetworkManager VPN profiles created by this script (prefix = provider).
nm_ours() {
  nmcli -t -f NAME,TYPE connection show --active |
    awk -F: -v re="^${1:-(nordvpn|vpnd)}-" '$2 == "vpn" && $1 ~ re {print $1}'
}

nm_user_of() {
  nmcli -g vpn.data connection show id "$1" | sed 's/\\,/;/g' | tr ',' '\n' | sed -n 's/^ *username = //p' | head -n 1
}

# Imported profiles carry no username and nmcli --ask only asks for the password,
# so copy it from another profile of the provider or ask for it once.
nm_ensure_user() {
  local provider=$1 name=$2 user='' other
  [[ -z $(nm_user_of "$name") ]] || return 0
  while IFS= read -r other; do
    user=$(nm_user_of "$other")
    [[ -z $user ]] || break
  done < <(nmcli -t -f NAME connection show | awk -v p="$provider-" 'index($0, p) == 1')
  if [[ -z $user ]]; then
    [[ -t 0 ]] || die "Falta el usuario de $name; ejecuta ovpn en un terminal o con DMS."
    read -r -p "Usuario de servicio $provider: " user
  fi
  [[ $user =~ ^[A-Za-z0-9._@+-]+$ ]] || die 'Usuario no válido.'
  nmcli connection modify id "$name" +vpn.data "username=$user"
}

# Import one .ovpn as a NetworkManager profile unless it already exists.
nm_import() {
  local name=$1 config=$2 tmp
  if nmcli -t -f NAME connection show | grep -Fxq -- "$name"; then
    return 0
  fi
  tmp=$(mktemp -d)
  cp -- "$config" "$tmp/$name.ovpn"
  if ! nmcli connection import type openvpn file "$tmp/$name.ovpn" >/dev/null; then
    rm -f -- "$tmp/$name.ovpn"
    rmdir -- "$tmp"
    return 1
  fi
  rm -f -- "$tmp/$name.ovpn"
  rmdir -- "$tmp"
  nmcli connection modify id "$name" connection.autoconnect no
}

nm_start() {
  local provider=$1 server=$2 protocol=$3 config=$4 name user='' pass='' item
  name="$provider-$server-$protocol"
  if [[ $auth_mode == file ]]; then
    [[ -f $CRED_FILE && $(stat -c %a "$CRED_FILE") == 600 ]] ||
      die "Falta $CRED_FILE con modo 600; créalo con: ovpn login"
    user=$(sed -n 's/^username=//p' "$CRED_FILE" | head -n 1)
    pass=$(sed -n 's/^password=//p' "$CRED_FILE" | head -n 1)
    [[ $user =~ ^[A-Za-z0-9._@+-]+$ && -n $pass ]] ||
      die "Credenciales incompletas en $CRED_FILE; repite: ovpn login"
  fi
  nm_import "$name" "$config" || die "No se pudo importar el perfil $name en NetworkManager."
  [[ $auth_mode == file ]] || nm_ensure_user "$provider" "$name"
  # Only one of our VPNs at a time.
  while IFS= read -r item; do
    [[ $item == "$name" ]] || nmcli connection down id "$item" >/dev/null
  done < <(nm_ours)
  if [[ $auth_mode == file ]]; then
    nmcli connection modify id "$name" +vpn.data "username=$user"
    PASSFILE=$(mktemp)
    printf 'vpn.secrets.password:%s\n' "$pass" >"$PASSFILE"
    nmcli connection up id "$name" passwd-file "$PASSFILE" || die "No se pudo conectar $name."
  else
    # Saved secrets are used silently; missing ones are asked for in the terminal.
    nmcli --ask connection up id "$name" || die "No se pudo conectar $name."
  fi
  printf 'Conectado: %s\n' "$name"
}

nm_stop() {
  local provider=${1:-} re='(nordvpn|vpnd)' item
  local -a active
  [[ -z $provider || $provider == all ]] || re=$provider
  mapfile -t active < <(nm_ours "$re")
  ((${#active[@]})) || {
    printf 'No hay VPN de NetworkManager activas.\n'
    return
  }
  if [[ -n $provider ]]; then
    item=all
  elif ((${#active[@]} == 1)); then
    item=${active[0]}
  else
    item=$(printf '%s\nall\n' "${active[@]}" | pick 'Desconectar') || die 'Selección cancelada.'
  fi
  if [[ $item == all ]]; then
    for item in "${active[@]}"; do nmcli connection down id "$item"; done
  else
    nmcli connection down id "$item"
  fi
}

nm_status() {
  local re='(nordvpn|vpnd)'
  local -a active
  if (($# == 1)); then re=$1; fi
  mapfile -t active < <(nm_ours "$re")
  ((${#active[@]})) || {
    printf 'VPN desconectada (NetworkManager).\n'
    return
  }
  printf '%s: activa\n' "${active[@]}"
}

login() {
  local user pass
  [[ -t 0 ]] || die 'ovpn login necesita un terminal.'
  read -r -p 'Usuario de servicio NordVPN: ' user
  read -r -s -p 'Contraseña de servicio: ' pass
  printf '\n'
  [[ $user =~ ^[A-Za-z0-9._@+-]+$ && -n $pass ]] || die 'Usuario o contraseña no válidos.'
  (
    umask 077
    mkdir -p -- "${CRED_FILE%/*}"
    printf 'username=%s\npassword=%s\n' "$user" "$pass" >"$CRED_FILE"
  )
  chmod 600 -- "$CRED_FILE"
  printf 'Credenciales guardadas en %s (modo 600, fuera de Git).\n' "$CRED_FILE"
}

# Preload NordVPN profiles into NetworkManager so DMS lists them.
import_profiles() {
  local protocol=udp per=1 yes='' countries='' servers='' api='' id='' found='' code server name config answer
  local imported=0 existing_n=0 missing=0 failed=0 i=0 existing
  local -a codes=() names=() plan=()
  while (($#)); do
    case $1 in
    --countries | --servers | --protocol | --per-country)
      (($# >= 2)) || die "$1 requiere un valor."
      case $1 in
      --countries) countries=$2 ;;
      --servers) servers=$2 ;;
      --protocol) protocol=$2 ;;
      --per-country) per=$2 ;;
      esac
      shift 2
      ;;
    --yes)
      yes=1
      shift
      ;;
    *) die "Opción desconocida: $1" ;;
    esac
  done
  [[ $backend == nm ]] || die 'import solo funciona con --backend nm.'
  [[ -n $countries || -n $servers ]] || die 'Indica --countries es,de|all y/o --servers es114,de920.'
  [[ $protocol == udp || $protocol == tcp ]] || die "Protocolo inválido: $protocol"
  [[ $per =~ ^[1-9][0-9]*$ ]] || die '--per-country requiere un entero positivo.'
  need nmcli
  need curl
  need jq
  [[ -d $NORDVPN_DIR ]] || die "No existe $NORDVPN_DIR; extrae allí el ZIP de NordVPN."

  api=$(curl -fsS --max-time 10 "$API/servers/countries" 2>/dev/null |
    jq -er '.[] | [(.code | ascii_downcase), (.id | tostring)] | @tsv' 2>/dev/null) || api=''
  IFS=, read -r -a codes <<<"${countries,,}"
  IFS=, read -r -a names <<<"${servers,,}"
  if [[ ${codes[0]:-} == all ]]; then
    if [[ -n $api ]]; then
      mapfile -t codes < <(cut -f1 <<<"$api")
    else
      mapfile -t codes < <(local_servers "$protocol" | sed -nE 's/^([a-z]{2})[0-9]+$/\1/p' | sort -u)
    fi
  fi
  [[ -n $api ]] || printf 'Aviso: API de NordVPN no disponible; se usan los perfiles locales.\n' >&2
  for code in "${codes[@]}"; do
    [[ $code =~ ^[a-z]{2}$ ]] || die "Código de país inválido: $code"
    id=$(awk -F '\t' -v c="$code" '$1 == c {print $2; exit}' <<<"$api")
    found=''
    if [[ -n $id ]]; then
      found=$(curl -fsS --max-time 10 \
        "$API/servers/recommendations?filters%5Bcountry_id%5D=$id&filters%5Bservers_technologies%5D%5Bidentifier%5D=openvpn_$protocol&limit=$per" 2>/dev/null |
        jq -er '.[].hostname | sub("\\.nordvpn\\.com$"; "")' 2>/dev/null) || found=''
    fi
    if [[ -z $found ]]; then
      found=$(local_servers "$protocol" "$code" | grep -E "^${code}[0-9]+$" | head -n "$per" || true)
    fi
    if [[ -z $found ]]; then
      printf 'Aviso: sin servidores para %s.\n' "$code" >&2
      continue
    fi
    while IFS= read -r server; do names+=("$server"); done <<<"$found"
  done
  for server in "${names[@]}"; do
    [[ $server =~ ^[a-z]{2}(-[a-z]+)?[0-9]+$ ]] || die "Servidor inválido: $server"
  done
  ((${#names[@]})) || die 'No hay nada que importar.'
  mapfile -t plan < <(printf '%s\n' "${names[@]}" | sort -u)

  if ((${#plan[@]} > 20)) && [[ -z $yes ]]; then
    [[ -t 0 ]] || die "Hay ${#plan[@]} perfiles; confirma con --yes."
    read -r -p "¿Importar ${#plan[@]} perfiles en NetworkManager? [s/N] " answer
    [[ $answer == [sSyY] ]] || die 'Cancelado.'
  fi
  existing=$(nmcli -t -f NAME connection show)
  for server in "${plan[@]}"; do
    i=$((i + 1))
    name="nordvpn-$server-$protocol"
    config="$NORDVPN_DIR/ovpn_$protocol/$server.nordvpn.com.$protocol.ovpn"
    if grep -Fxq -- "$name" <<<"$existing"; then
      existing_n=$((existing_n + 1))
    elif [[ ! -f $config ]]; then
      missing=$((missing + 1))
      printf 'Aviso: sin perfil local para %s (¿ZIP desactualizado?).\n' "$server" >&2
    elif nm_import "$name" "$config"; then
      imported=$((imported + 1))
    else
      failed=$((failed + 1))
      printf 'Error: no se pudo importar %s.\n' "$name" >&2
    fi
    if ((i % 10 == 0)); then printf '%d/%d\n' "$i" "${#plan[@]}"; fi
  done
  printf 'Importados: %d, ya existían: %d, sin perfil local: %d, fallidos: %d.\n' \
    "$imported" "$existing_n" "$missing" "$failed"
  ((failed == 0)) || exit 1
}

# Our VPN profiles in NetworkManager, one per line.
nm_profiles() {
  nmcli -t -f NAME,TYPE connection show |
    awk -F: '$2 == "vpn" && $1 ~ /^(nordvpn|vpnd)-/ {print $1}'
}

# Targets of creds set/delete: a profile name, --provider nordvpn|vpnd, or --all.
creds_targets() {
  case ${1:-} in
  --all) nm_profiles ;;
  --provider)
    provider_ok "${2:-}" || die 'Uso: --provider nordvpn|vpnd'
    nm_profiles | grep -E "^$2-" || true
    ;;
  '') die 'Indica un perfil, --provider nordvpn|vpnd o --all.' ;;
  -*) die "Opción desconocida: $1" ;;
  *) nm_profiles | grep -Fx -- "$1" || die "Perfil no encontrado (solo nordvpn-* / vpnd-*): $1" ;;
  esac
}

creds() {
  local action=${1:-} targets user pass='' item answer
  local -a list
  shift || true
  need nmcli
  case $action in
  list)
    while IFS= read -r item; do
      user=$(nm_user_of "$item")
      printf '%s\t%s\n' "$item" "${user:--}"
    done < <(nm_profiles)
    ;;
  set | delete)
    targets=$(creds_targets "$@") || exit 1
    [[ -n $targets ]] || die 'No hay perfiles que coincidan.'
    mapfile -t list <<<"$targets"
    [[ -t 0 ]] || die "creds $action necesita un terminal."
    if [[ $action == set ]]; then
      read -r -p "Usuario de servicio para ${#list[@]} perfil(es): " user
      [[ $user =~ ^[A-Za-z0-9._@+-]+$ ]] || die 'Usuario no válido.'
      read -r -s -p 'Contraseña de servicio (vacía = no cambiarla): ' pass
      printf '\n'
      # nmcli splits dictionary values on commas, so they cannot be stored safely.
      [[ -z $pass || $pass =~ ^[^,[:space:]\\]+$ ]] || die 'La contraseña no puede llevar comas, espacios ni barras invertidas.'
      for item in "${list[@]}"; do
        if [[ -z $pass ]]; then
          nmcli connection modify id "$item" +vpn.data "username=$user"
        else
          nmcli connection modify id "$item" +vpn.data "username=$user,password-flags=0"
          # Through stdin so the password never appears in the process list.
          printf 'set vpn.secrets password=%s\nsave\nquit\n' "$pass" |
            nmcli connection edit id "$item" >/dev/null || die "No se pudo guardar la contraseña en $item."
        fi
      done
      printf 'Actualizados %d perfil(es).\n' "${#list[@]}"
    else
      read -r -p "¿Borrar ${#list[@]} perfil(es) de NetworkManager, con su usuario y contraseña? [s/N] " answer
      [[ $answer == [sSyY] ]] || die 'Cancelado.'
      for item in "${list[@]}"; do
        nmcli connection delete id "$item" >/dev/null || die "No se pudo borrar $item."
        # NetworkManager leaves the imported certificates behind.
        rm -f -- "$HOME/.local/share/networkmanagement/certificates/nm-openvpn/$item"-*.pem
      done
      printf 'Borrados %d perfil(es). Lo que DMS tenga en su agente de secretos no se borra desde aquí.\n' "${#list[@]}"
    fi
    ;;
  *) die 'Uso: ovpn creds list | set <perfil|--provider P|--all> | delete <perfil|--provider P|--all>' ;;
  esac
}

pick() {
  local prompt=$1 item
  local -a items
  if command -v fzf >/dev/null; then
    fzf --prompt="$prompt: " --height=50% --border --cycle
  else
    mapfile -t items
    ((${#items[@]})) || return 1
    PS3="$prompt: "
    select item in "${items[@]}"; do
      if [[ -n $item ]]; then
        printf '%s\n' "$item"
        return
      fi
      printf 'Selección inválida.\n' >&2
    done </dev/tty
    return 1
  fi
}

local_servers() {
  local proto=$1 country=${2:-} file
  for file in "$NORDVPN_DIR/ovpn_$proto/$country"*.ovpn; do
    file=${file##*/}
    printf '%s\n' "${file%%.nordvpn.com.*}"
  done | sort -u
}

select_nordvpn() {
  local countries country code id name servers cities city row
  # An unavailable or empty API response falls back to local profiles.
  if countries=$(curl -fsS --max-time 5 "$API/servers/countries" 2>/dev/null |
    jq -er '.[] | [.code, (.id | tostring), .name] | @tsv' 2>/dev/null | sort -k3) && [[ -n $countries ]]; then
    :
  else
    countries=$(local_servers "$protocol" | sed -nE 's/^([a-z]{2})[0-9]+$/\U\1/p' | sort -u |
      awk '{printf "%s\t-\t(local)\n", $0}')
  fi
  [[ -n $countries ]] || die 'No hay países disponibles ni perfiles locales.'
  country=$(printf '%s\n' "$countries" | pick 'País') || die 'Selección cancelada.'
  IFS=$'\t' read -r code id name <<<"$country"
  [[ $code =~ ^[A-Z]{2}$ && $id =~ ^([0-9]+|-)$ ]] || die 'País inválido.'

  servers=''
  if [[ $id != - ]]; then
    servers=$(curl -fsS --max-time 5 \
      "$API/servers/recommendations?filters%5Bcountry_id%5D=$id&filters%5Bservers_technologies%5D%5Bidentifier%5D=openvpn_$protocol&limit=$limit" 2>/dev/null |
      jq -er 'sort_by(.load) | .[] | ["load: \(.load)%", (.locations[0].country.city.name // "?"), .hostname] | @tsv' 2>/dev/null) || servers=''
  fi
  if [[ -z $servers ]]; then
    # Only plain country servers: "ch*" would also match double-VPN files such as ch-fr12.
    servers=$(local_servers "$protocol" "${code,,}" | { grep -E "^${code,,}[0-9]+$" || true; } |
      awk '{printf "local\t?\t%s\n", $0}')
  fi
  [[ -n $servers ]] || die "No hay servidores para $name/$protocol."
  cities=$(printf '%s\n' "$servers" | cut -f2 | sort -u)
  if [[ $cities == *$'\n'* ]]; then
    city=$(printf 'Todas\n%s\n' "$cities" | pick 'Ciudad') || die 'Selección cancelada.'
    if [[ $city != Todas ]]; then
      servers=$(printf '%s\n' "$servers" | awk -F '\t' -v city="$city" '$2 == city')
    fi
  fi
  row=$(printf '%s\n' "$servers" | pick 'Servidor') || die 'Selección cancelada.'
  server=${row##*$'\t'}
  server=${server%.nordvpn.com}
}

select_server() {
  local -a providers=() files=()
  local file
  [[ ! -d $NORDVPN_DIR ]] || providers+=(nordvpn)
  [[ ! -d $VPND_DIR ]] || providers+=(vpnd)
  ((${#providers[@]})) || die 'No hay directorios de proveedores OpenVPN.'
  provider=$(printf '%s\n' "${providers[@]}" | pick 'Proveedor') || die 'Selección cancelada.'
  provider_ok "$provider" || die 'Proveedor inválido.'
  protocol=$(printf 'udp\ntcp\n' | pick 'Protocolo') || die 'Selección cancelada.'
  [[ $protocol == udp || $protocol == tcp ]] || die 'Protocolo inválido.'
  if [[ $provider == nordvpn ]]; then
    select_nordvpn
  else
    files=("$VPND_DIR/$protocol/"*.ovpn)
    ((${#files[@]})) || die "No hay perfiles vpnd/$protocol."
    server=$(for file in "${files[@]}"; do
      file=${file##*/}
      printf '%s\n' "${file%.ovpn}"
    done | pick 'Servidor') || die 'Selección cancelada.'
  fi
}

start() {
  local limit=20 server='' protocol=tcp provider=vpnd config auth service binary
  local -a positional=()
  while (($#)); do
    case $1 in
    --limit)
      (($# >= 2)) && [[ $2 =~ ^[1-9][0-9]*$ ]] || die '--limit requiere un entero positivo.'
      limit=$2
      shift 2
      ;;
    -*) die "Opción desconocida: $1" ;;
    *)
      positional+=("$1")
      shift
      ;;
    esac
  done
  ((${#positional[@]} <= 3)) || die 'Demasiados argumentos para start.'
  if [[ $backend == nm ]]; then
    need nmcli
  else
    need systemctl
    need systemd-run
    need openvpn
  fi
  if ((${#positional[@]})); then
    server=${positional[0]}
    protocol=${positional[1]:-tcp}
    provider=${positional[2]:-vpnd}
  else
    select_server
  fi
  provider_ok "$provider" || die "Proveedor inválido: $provider"
  [[ $protocol == udp || $protocol == tcp ]] || die "Protocolo inválido: $protocol"
  [[ $server =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ && $server != *..* ]] || die 'Servidor inválido.'
  case $provider in
  nordvpn) config="$NORDVPN_DIR/ovpn_$protocol/$server.nordvpn.com.$protocol.ovpn" ;;
  vpnd) config="$VPND_DIR/$protocol/$server.ovpn" ;;
  esac
  [[ -f $config ]] || die "Perfil no encontrado: $config"
  if [[ $backend == nm ]]; then
    nm_start "$provider" "$server" "$protocol" "$config"
    return
  fi
  auth="/etc/openvpn/$provider/auth"
  need sudo
  sudo test -f "$auth" || die "Faltan las credenciales locales: $auth"
  # Legacy PID files are untrusted: never feed their contents to sudo kill.
  [[ ! -e /tmp/openvpn-nordvpn.pid && ! -e /tmp/openvpn-vpnd.pid ]] ||
    die 'Hay estado de los scripts antiguos en /tmp/openvpn-*.pid; revisa y desconecta esas sesiones primero.'
  service=$(unit "$provider")
  binary=$(command -v openvpn)
  if running "$provider"; then
    sudo systemctl stop "$service"
  fi
  sudo systemd-run --unit="$service" --collect --property=Type=exec --expand-environment=no -- \
    "$binary" --cd "${config%/*}" --config "$config" --auth-user-pass "$auth" --auth-nocache
  printf 'Proceso iniciado para %s/%s (%s); esto no confirma que el túnel esté conectado.\n' "$provider" "$server" "$protocol"
  printf 'Comprueba la conexión en: journalctl -u %s\n' "$service"
}

stop() {
  local provider=${1:-} item
  local -a active=()
  (($# <= 1)) || die 'Uso: ovpn stop [nordvpn|vpnd|all]'
  [[ -z $provider || $provider == all ]] || provider_ok "$provider" || die 'Proveedor inválido.'
  if [[ $backend == nm ]]; then
    need nmcli
    nm_stop "$provider"
    return
  fi
  need systemctl
  if [[ -z $provider ]]; then
    for item in nordvpn vpnd; do
      if running "$item"; then active+=("$item"); fi
    done
    ((${#active[@]})) || {
      printf 'No hay servicios OpenVPN activos gestionados por este comando.\n'
      return
    }
    if ((${#active[@]} == 1)); then
      provider=${active[0]}
    else
      provider=$(printf '%s\nall\n' "${active[@]}" | pick 'Desconectar') || die 'Selección cancelada.'
    fi
  fi
  need sudo
  case $provider in
  all)
    for item in nordvpn vpnd; do
      if running "$item"; then sudo systemctl stop "$(unit "$item")"; fi
    done
    ;;
  nordvpn | vpnd) sudo systemctl stop "$(unit "$provider")" ;;
  *) die 'Proveedor inválido.' ;;
  esac
}

status() {
  local provider
  local -a providers=(nordvpn vpnd)
  (($# <= 1)) || die 'Uso: ovpn status [nordvpn|vpnd]'
  if (($#)); then
    provider_ok "$1" || die 'Proveedor inválido.'
    providers=("$1")
  fi
  if [[ $backend == nm ]]; then
    need nmcli
    nm_status "${providers[@]}"
    return
  fi
  need systemctl
  for provider in "${providers[@]}"; do
    printf '%s (estado del proceso, no del túnel):\n' "$provider"
    systemctl show "$(unit "$provider")" --property=ActiveState,SubState,Result
  done
}

backend=${OVPN_BACKEND:-nm}
auth_mode=${OVPN_AUTH:-dms}
args=()
while (($#)); do
  case $1 in
  --backend | --auth)
    (($# >= 2)) || die "$1 requiere un valor."
    if [[ $1 == --backend ]]; then backend=$2; else auth_mode=$2; fi
    shift 2
    ;;
  *)
    args+=("$1")
    shift
    ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"
[[ $backend == nm || $backend == systemd ]] || die "Backend inválido: $backend (usa nm o systemd)."
[[ $auth_mode == dms || $auth_mode == file ]] || die "Auth inválido: $auth_mode (usa dms o file)."

case ${1:-help} in
help | -h | --help) usage ;;
import)
  shift
  import_profiles "$@"
  ;;
start | stop | status | login | creds)
  action=$1
  shift
  "$action" "$@"
  ;;
*)
  usage >&2
  exit 2
  ;;
esac
