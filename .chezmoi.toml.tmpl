{{- $isWindows := eq .chezmoi.os "windows" -}}
{{- /* Profile: full = everything, minimal = CLI + shell only, custom = ask per module */ -}}
{{- $profile := promptChoiceOnce . "install_profile" "Install profile" (list "full" "minimal" "custom") "full" -}}

{{- /* ai_agents = the coding agents' configs: .claude, .codex, .factory, .grok, .omp, .pi, .pi-lens, .agents, .config/caveman */ -}}
{{- $common := list "zed" "yazi" "btop" "fastfetch" "cava" "gh_dash" "micro" "opencode" "starship" "ohmyposh" "bun" "git" "gitui" "uv" "zellij" "ytm_player" "tmux" "herdr" "wezterm" "alacritty" "ai_agents" "pnpm" "vesktop" -}}
{{- $linuxOnly := list "zsh" "aerc" "nchat" "freetube" "concord" "dms" -}}
{{- /* aether = the desktop shell (Aether: Caelestia on Quickshell + AetherWM) and its ~/.config/{caelestia,hypr} */ -}}
{{- $windowsOnly := list "aether" "nilesoft" "autohotkey" "altsnap" "warp" "windows_terminal" "junctions" "startup" -}}
{{- /* Modules turned off by the minimal profile; everything else stays on */ -}}
{{- $minimalOff := list "aerc" "nchat" "freetube" "vesktop" "concord" "dms" "aether" "nilesoft" "autohotkey" "altsnap" "warp" "startup" -}}
{{- $active := concat $common (ternary $windowsOnly $linuxOnly $isWindows) -}}
{{- $inactive := ternary $linuxOnly $windowsOnly $isWindows -}}
encryption = "gpg"
mode = "symlink"

[gpg]
    recipient = "2E5BD225E500AB50"
    {{ if $isWindows -}}
    command = "C:/Program Files/GnuPG/bin/gpg.exe"
    {{- end }}

[git]
    autoCommit = false
    autoPush = false

[data]
    isWindows = {{ $isWindows }}
    install_profile = {{ $profile | quote }}

    # ── Owner-only — do NOT enable unless you are Villoh ─────────────────────
    enable_secrets = {{ promptBool "Enable personal secrets (owner only — requires Bitwarden)" false }}

    # ── Modules for this OS (custom profile asks one by one; Enter keeps the previous answer) ──
{{- range $active }}
{{- $key := printf "enable_%s" . }}
{{- $val := true }}
{{- if eq $profile "minimal" }}
{{- $val = not (has . $minimalOff) }}
{{- else if eq $profile "custom" }}
{{- $default := true }}
{{- if hasKey $ $key }}{{ $default = get $ $key }}{{ end }}
{{- $val = promptBool (printf "Enable %s" .) $default }}
{{- end }}
    {{ $key }} = {{ $val }}
{{- end }}

    # ── Modules that do not exist on this OS ─────────────────────────────────
{{- range $inactive }}
    enable_{{ . }} = false
{{- end }}
