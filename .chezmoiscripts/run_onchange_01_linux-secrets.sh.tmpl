{{ if and (ne .chezmoi.os "windows") .enable_secrets -}}
#!/bin/bash
# secrets.json {{ include "packages/linux/system/secrets.json" | sha256sum }}
set -euo pipefail

CONFIG_FILE="{{ .chezmoi.sourceDir }}/packages/linux/system/secrets.json"

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "  [SKIP] secrets.json not found"
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "  [FAIL] python3 is required to process secrets.json"
  exit 1
fi

python3 - "$CONFIG_FILE" <<'PY'
import json
import os
import re
import shutil
import shlex
import sys
import tempfile
from pathlib import Path

config_file = Path(sys.argv[1])
config = json.loads(config_file.read_text(encoding="utf-8"))
env_name_re = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")

config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
terminal_file = config_home / "secrets" / "terminal-env.sh"
global_file = config_home / "secrets" / "global-env.sh"
os.umask(0o077)


def get_secret(spec):
    name = spec.get("name", "")
    if not env_name_re.fullmatch(name):
        print(f"  [SKIP] invalid environment variable name: {name}")
        return None
    if not spec.get("bw_item") or not spec.get("bw_field"):
        print(f"  [SKIP] {name} (missing bw_item or bw_field)")
        return None

    value = None
    if os.environ.get("BW_SESSION"):
        import subprocess
        result = subprocess.run(
            ["bw", "get", "item", spec["bw_item"]],
            check=False,
            capture_output=True,
            text=True,
        )
        if result.returncode == 0 and result.stdout.strip():
            item = json.loads(result.stdout)
            field = spec["bw_field"]
            if field in ("login.password", "password"):
                value = (item.get("login") or {}).get("password")
            elif field == "notes":
                value = item.get("notes")
            else:
                for custom_field in item.get("fields", []):
                    if custom_field.get("name") == field:
                        value = custom_field.get("value")
                        break

    if not value:
        print(f"  [MISS] {name} (no value)")
        return None

    return value


def build_entries(config):
    entries = []
    for group in ("terminal_envs", "global_envs"):
        entry_type = "terminal" if group == "terminal_envs" else "global"
        for spec in config.get(group) or []:
            label = f"[{entry_type:<8}] {spec.get('name', '')} <- {spec.get('bw_item', '')}.{spec.get('bw_field', '')}"
            entries.append({"type": entry_type, "spec": spec, "label": label})
    return entries


def select_entries(entries):
    if not entries:
        return []
    import subprocess
    if os.environ.get("SECRETS_SELECT_ALL"):
        print(f"  [WARN] SECRETS_SELECT_ALL is set - processing all {len(entries)} secrets")
        return entries
    if not shutil.which("fzf"):
        print(f"  [WARN] fzf not found - processing all {len(entries)} secrets")
        return entries
    result = subprocess.run(
        ["fzf", "--multi", "--bind", "ctrl-a:toggle-all,tab:toggle", "--prompt", "  Secrets> ", "--header", "Select secrets to refresh (Ctrl+A select all, Tab toggle, Enter confirm)"],
        input="\n".join(entry["label"] for entry in entries) + "\n",
        check=False,
        stdout=subprocess.PIPE,
        text=True,
    )
    selected = set(result.stdout.splitlines())
    if not selected:
        print("  [SKIP] no secrets selected")
        return []
    return [entry for entry in entries if entry["label"] in selected]


def write_private(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            output.write(content)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


entries = build_entries(config)
names = [entry["spec"].get("name", "") for entry in entries]
if any(not env_name_re.fullmatch(name) for name in names) or len(names) != len(set(names)):
    sys.exit("  [FAIL] environment variable names must be valid and unique across both groups")
selected_entries = select_entries(entries)
if not selected_entries:
    sys.exit(0)

# Parse our generated exports without executing them. Preserve unselected values
# and migrate the legacy merged file into the configured groups.
values = {}
for path in (global_file, terminal_file):
    if not path.exists():
        continue
    with path.open(encoding="utf-8", newline="") as source:
        tokens = shlex.split(source.read(), comments=True)
    if len(tokens) % 2 or any(token != "export" for token in tokens[::2]):
        sys.exit("  [FAIL] unsupported generated environment file; leaving files unchanged")
    for assignment in tokens[1::2]:
        name, separator, value = assignment.partition("=")
        if not separator or not env_name_re.fullmatch(name):
            sys.exit("  [FAIL] invalid generated assignment; leaving files unchanged")
        values[name] = value

for entry in selected_entries:
    spec = entry["spec"]
    value = get_secret(spec)
    name = spec["name"]
    if value:
        values[name] = value
        print(f"  [OK]   {name}")
    else:
        print(f"  [SKIP] {name} (keeping deployed value if present)")

for entry_type, path in (("terminal", terminal_file), ("global", global_file)):
    lines = ["# API keys -- generated by chezmoi from Bitwarden. Do not edit manually."]
    for entry in entries:
        name = entry["spec"]["name"]
        if entry["type"] == entry_type and name in values:
            lines.append(f"export {name}={shlex.quote(values[name])}")
    write_private(path, "\n".join(lines) + "\n")
    print(f"  Secrets written to {path}")

# Replace only our old hook; keep the rest of the user's Bash configuration.
bashrc = Path.home() / ".bashrc"
source_line = '[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/secrets/terminal-env.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/secrets/terminal-env.sh"'
old_line = '[ -r "$HOME/.config/secrets/global-env.sh" ] && . "$HOME/.config/secrets/global-env.sh"'
if bashrc.exists():
    original = bashrc.read_text(encoding="utf-8")
    updated = original.replace(old_line, source_line)
    if source_line not in updated.splitlines():
        updated += "\n# Bitwarden-managed terminal secrets\n" + source_line + "\n"
    if updated != original:
        bashrc.write_text(updated, encoding="utf-8")

# UWSM exports this environment to graphical applications and user services.
# Drop terminal-only values inherited from a login Bash before starting desktop.
terminal_names = [entry["spec"]["name"] for entry in entries if entry["type"] == "terminal"]
session_lines = ["# Generated by chezmoi; global secrets only."]
if terminal_names:
    session_lines.append("unset " + " ".join(terminal_names))
session_lines.append('[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/secrets/global-env.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/secrets/global-env.sh"')
write_private(config_home / "uwsm" / "env.d" / "60-chezmoi-secrets", "\n".join(session_lines) + "\n")
PY
{{ end -}}
