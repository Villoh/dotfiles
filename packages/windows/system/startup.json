{
  "registry": [
    {
      "name": "AltSnap",
      "path": "%APPDATA%\\AltSnap\\AltSnap.exe",
      "args": "-hide"
    }
  ],
  "msix": [],
  "scheduler": [
    {
      "name": "LibreHardwareMonitor",
      "path": "%LOCALAPPDATA%\\Microsoft\\WinGet\\Packages\\LibreHardwareMonitor.LibreHardwareMonitor_Microsoft.Winget.Source_8wekyb3d8bbwe\\LibreHardwareMonitor.exe",
      "runLevel": "Highest"
    }
  ],
  "folder": [
    {
      "name": "gpg-connect-agent",
      "path": "%ProgramFiles%\\GnuPG\\bin\\gpg-connect-agent.exe",
      "args": "/bye",
      "windowStyle": 7
    },
    { "name": "Hex", "tool": "github:anomalyco/hex", "exe": "hex.exe" },
    { "name": "Yapfast", "tool": "github:yapfast/yapfast", "exe": "yapfast.exe" },
    { "name": "ZapFast", "tool": "github:crmne/zapfast", "exe": "zapfast.exe" }
  ]
}
